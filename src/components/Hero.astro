---
// =========================================================================
// COMPOSANT HERO (src/components/Hero.astro)
// -------------------------------------------------------------------------
// Grand bandeau d'ouverture de la page d'accueil : titre principal (h1),
// sous-titre, bouton « Obtenir un devis » et 8 raccourcis vers les solutions.
//
// Direction visuelle « technique et clair » :
// - Deux blocs nettement séparés :
//     1. le message (fond blanc avec un fin quadrillage façon plan technique) ;
//     2. les raccourcis (bandeau bleu nuit, tuiles blanches très contrastées).
// - Aucune photo : uniquement du texte, des aplats et des icônes au trait.
// - 100 % Tailwind, uniquement les couleurs de la charte (global.css).
// - Mobile d'abord : les classes sans préfixe visent le téléphone, md: la
//   tablette (768px et plus), lg: et xl: l'ordinateur (992px et 1280px).
//
// Pour modifier un raccourci (libellé, lien ou icône) : éditer le tableau
// `raccourcis` ci-dessous.
// Le schéma de la maison est dans son propre composant : SchemaMaison.astro.
// =========================================================================

import SchemaMaison from './SchemaMaison.astro';

// -------------------------------------------------------------------------
// RACCOURCIS VERS LES SOLUTIONS
// - libelle : texte affiché sous l'icône.
// - href    : page de destination (certaines pages sont encore à créer,
//             voir inventaire-charte.md).
// - icone   : dessin SVG au trait, sur une grille de 24 × 24. Seuls les
//             tracés sont décrits ici : la couleur, l'épaisseur du trait et
//             la taille sont réglées une seule fois, plus bas, sur la balise
//             <svg>.
// -------------------------------------------------------------------------
const raccourcis = [
  {
    libelle: 'Isolation',
    href: '/solutions/isolation-thermique-par-l-exterieur-ite',
    // Maison à double paroi : le trait intérieur figure l'enveloppe
    // isolante qui double le toit et les murs.
    icone: `
      <path d="M2 11.5 12 3.5l10 8" />
      <path d="M4.5 9.5V21h15V9.5" />
      <path d="M7.5 11.5 12 8l4.5 3.5V18h-9Z" />
    `,
  },
  {
    libelle: 'Fenêtres et volets',
    href: '/solutions/menuiseries-fenetres-volets',
    // Fenêtre à deux battants encadrée de deux volets.
    icone: `
      <rect x="8" y="3" width="8" height="16" rx="1" />
      <path d="M12 3v16M8 11h8" />
      <path d="M2.5 3h3v16h-3zM18.5 3h3v16h-3z" />
      <path d="M2 21h20" />
    `,
  },
  {
    libelle: 'Pompe à chaleur',
    href: '/solutions/pompe-a-chaleur-air-eau',
    // Unité extérieure : ventilateur à gauche, grille d'aération à droite.
    icone: `
      <rect x="2" y="5" width="20" height="13" rx="2" />
      <circle cx="9" cy="11.5" r="4" />
      <path d="M9 7.5v8M5 11.5h8" />
      <path d="M16 9h3M16 11.5h3M16 14h3" />
      <path d="M5 18v2M19 18v2" />
    `,
  },
  {
    libelle: 'Climatisation réversible',
    href: '/solutions/climatisation-reversible-pac-air-air',
    // Unité murale qui souffle de l'air (trois flèches vers le bas).
    icone: `
      <rect x="2" y="4" width="20" height="8" rx="2" />
      <path d="M5 9h14" />
      <path d="M7 15v4M12 15v6M17 15v4" />
      <path d="m5.5 17.5 1.5 1.5 1.5-1.5M10.5 19.5 12 21l1.5-1.5M15.5 17.5 17 19l1.5-1.5" />
    `,
  },
  {
    libelle: 'Chaudière biomasse',
    href: '/solutions/chaudiere-biomasse-bois-ou-pellets',
    // Flamme posée sur une bûche.
    icone: `
      <path d="M12 2.5c.5 3 3.5 4.5 3.5 8a3.5 3.5 0 0 1-7 0c0-1.5.7-2.5 1.5-3.5.3 1.2 1 1.8 1.8 1.8C11.5 7 11 4.5 12 2.5Z" />
      <path d="M4 19.5 20 16M4 16l16 3.5" />
    `,
  },
  {
    libelle: 'Chauffe-eau',
    href: '/solutions/chauffe-eau-thermodynamique',
    // Ballon d'eau chaude (cylindre) avec une goutte, et ses deux tuyaux.
    icone: `
      <path d="M6 5a6 2 0 0 1 12 0v13a6 2 0 0 1-12 0Z" />
      <path d="M12 9c1.5 2 2.5 3.2 2.5 4.5a2.5 2.5 0 0 1-5 0c0-1.3 1-2.5 2.5-4.5Z" />
      <path d="M9 22v-2M15 22v-2" />
    `,
  },
  {
    libelle: 'Panneaux photovoltaïques',
    href: '/solutions/panneaux-photovoltaiques',
    // Panneau solaire incliné et quadrillé, sur son pied.
    icone: `
      <path d="M5 4h16l-2 10H3Z" />
      <path d="M4 9h16M10.3 4l-2 10M15.7 4l-2 10" />
      <path d="M11 14v5M7 20h8" />
    `,
  },
  {
    libelle: 'Borne de recharge',
    href: '/solutions/borne-de-recharge',
    // Borne avec écran et éclair, câble qui sort sur le côté.
    icone: `
      <rect x="4" y="3" width="10" height="18" rx="2" />
      <path d="M6.5 6h5v3h-5z" />
      <path d="m10 12-2 3h3l-2 3" />
      <path d="M14 8h2a2 2 0 0 1 2 2v6a1.5 1.5 0 0 0 3 0v-5" />
      <path d="M2 21h14" />
    `,
  },
];
---

{/* =========================================================================
    SECTION HERO
    aria-labelledby relie la section à son titre pour les lecteurs d'écran.

    ORDRE DES BLOCS (dans le code comme à l'écran, sous 1280px) :
      1. le message (titre, sous-titre, bouton) ;
      2. les raccourcis vers les solutions (pages de vente : ils doivent
         rester visibles sans défiler) ;
      3. le schéma de la maison.
    À partir de 1280px (xl:), le schéma remonte à DROITE du message :
    la section devient une grille, et le message et le schéma occupent la
    même case (xl:col-start-1 xl:row-start-1), le schéma étant aligné sur
    la colonne de droite. Les raccourcis passent alors sur la 2e ligne.
    L'ordre au clavier reste : message → raccourcis → schéma.
========================================================================== */}
<section aria-labelledby="hero-titre" class="grid border-b-2 border-bordure">

  {/* -----------------------------------------------------------------------
      BLOC 1 : LE MESSAGE
      Fond blanc avec un fin quadrillage (lignes neutre-100 tous les 2rem),
      rappel discret d'un plan technique. Il est purement décoratif et assez
      pâle pour ne pas gêner la lecture.
  ------------------------------------------------------------------------ */}
  <div class="bg-fond bg-[linear-gradient(to_right,var(--color-neutre-100)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-neutre-100)_1px,transparent_1px)] bg-size-[2rem_2rem] xl:col-start-1 xl:row-start-1 xl:flex xl:items-center">
    {/* Marges verticales resserrées sur téléphone (pt-4 = 16px en haut,
        pb-6 = 24px en bas) pour que le bouton et la 1re rangée de raccourcis
        restent visibles sans défiler. À partir de 768px (md:) : inchangé. */}
    <div class="mx-auto w-full max-w-site px-gouttiere pt-4 pb-6 md:py-section">

      {/* À partir de 1280px : le message occupe les 7/12 de gauche ; les
          5/12 de droite restent vides ici, car le schéma (bloc 3) vient s'y
          superposer. */}
      <div class="xl:grid xl:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] xl:gap-bloc">

        {/* COLONNE TEXTE : titre, sous-titre et bouton */}
        <div>
          {/* Barre orange décorative : repère visuel au-dessus du titre */}
          <span aria-hidden="true" class="mb-3 block h-1.5 w-16 bg-action-500 md:mb-6 md:h-2"></span>

          {/* TITRE PRINCIPAL (17 mots)
              - text-display : la plus grande taille de la charte (3.5rem,
                réduite à 1.75rem sur téléphone, voir global.css).
              - max-w-[24ch] : limite chaque ligne à environ 24 caractères,
                pour que l'œil lise le titre par blocs courts (5 lignes sur
                ordinateur au lieu d'une seule ligne interminable).
              - text-balance : le navigateur équilibre la longueur des
                lignes, pour éviter un mot isolé sur la dernière ligne. */}
          <h1 id="hero-titre" class="max-w-[24ch] text-display text-balance text-texte">
            Construire, rénover et équiper votre logement pour réduire votre consommation d'énergie et vos factures
          </h1>

          <div class="mt-3 md:mt-8">
            {/* SOUS-TITRE : taille h4 (1.25rem) mais graisse normale, gris
                foncé neutre-700 (contraste élevé sur fond blanc). */}
            <p class="max-w-[45ch] text-h4 font-normal text-neutre-700">
              Avec un artisan local du collectif Akelia, en direct et sans sous-traitance.
            </p>
  
            {/* BOUTON PRINCIPAL
                - min-h-14 : 56px de haut, très confortable au doigt.
                - Texte noir sur orange : l'orange est trop clair pour porter
                  du texte blanc lisible.
                - Pleine largeur sur téléphone, largeur du texte au-delà. */}
            <a
              href="/devis"
              class="mt-4 flex min-h-14 w-full items-center justify-center gap-3 rounded-bouton bg-action-500 px-8 text-h4 font-semibold text-texte shadow-legere hover:bg-action-600 hover:inset-shadow-presse focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-marque-900 md:mt-6 md:inline-flex md:w-auto"
            >
              Obtenir un devis
              {/* Flèche décorative */}
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* -----------------------------------------------------------------------
      BLOC 2 : LES RACCOURCIS VERS LES SOLUTIONS
      Bandeau bleu nuit (marque-900) : la séparation avec le bloc du message
      est immédiate, et les tuiles blanches ressortent fortement.
      Grille : 2 colonnes sur téléphone, 4 sur tablette (md:) et sur petit
      ordinateur (4 × 2), 8 en une ligne à partir de 1280px (xl:).
  ------------------------------------------------------------------------ */}
  <nav aria-label="Accès rapide à nos solutions" class="bg-marque-900">
    <ul class="mx-auto grid max-w-site grid-cols-2 gap-3 px-gouttiere py-4 md:grid-cols-4 md:gap-4 md:py-bloc xl:grid-cols-8">
      {raccourcis.map((raccourci) => (
        <li>
          {/* TUILE : le lien couvre toute la tuile (icône + libellé).
              - Hauteur : 80px minimum sur téléphone (min-h-20), 128px à partir
                de 768px (md:min-h-32). Dans les deux cas, bien au-delà des
                44px minimum. Une tuile dont le libellé tient sur 2 lignes
                grandit un peu sur téléphone (environ 90px).
              - Sur téléphone, icône et marges intérieures plus petites pour
                tenir dans ces 80px ; inchangées à partir de 768px.
              - Survol : fond crème action-50 et cadre orange épais.
              - xl:px-2 : en 8 colonnes, marge intérieure réduite pour que
                « photovoltaïques » tienne sur une ligne sans être coupé.
              - Focus clavier : contour orange épais, décalé de la tuile. */}
          <a
            href={raccourci.href}
            class="group flex h-full min-h-20 flex-col items-center justify-center gap-1 rounded-carte bg-fond px-3 py-2 text-center md:min-h-32 md:gap-3 md:p-4 xl:px-2 ring-action-500 transition-colors hover:bg-action-50 hover:ring-4 focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-action-500 motion-reduce:transition-none"
          >
            {/* Icône au trait : couleur de la marque, épaisseur 1.75 */}
            <svg
              class="size-8 text-marque-900 md:size-10"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={raccourci.icone} />
            </svg>
            {/* Libellé : semi-gras, texte noir */}
            <span class="text-base leading-tight font-semibold text-texte md:leading-normal">
              {raccourci.libelle}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {/* -----------------------------------------------------------------------
      BLOC 3 : LE SCHÉMA DE LA MAISON (SchemaMaison.astro)
      - Sous 1280px : après les raccourcis, sur le même fond quadrillé que le
        message. Largeur limitée à 42rem sur tablette (md:max-w-2xl).
      - À partir de 1280px : superposé au bloc 1, dans la colonne de droite
        (5/12), centré verticalement. Il n'a alors plus de fond propre (le
        quadrillage du bloc 1 passe dessous). pointer-events-none sur le
        conteneur, puis auto sur le schéma : le texte et le bouton du bloc 1
        restent cliquables partout ailleurs.
  ------------------------------------------------------------------------ */}
  <div class="bg-fond bg-[linear-gradient(to_right,var(--color-neutre-100)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-neutre-100)_1px,transparent_1px)] bg-size-[2rem_2rem] xl:pointer-events-none xl:col-start-1 xl:row-start-1 xl:bg-transparent xl:bg-none">
    <div class="mx-auto w-full max-w-site px-gouttiere py-6 md:py-bloc xl:grid xl:h-full xl:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] xl:items-center xl:gap-bloc xl:py-section">
      <div class="md:max-w-2xl xl:pointer-events-auto xl:col-start-2 xl:max-w-none">
        <SchemaMaison />
      </div>
    </div>
  </div>
</section>
