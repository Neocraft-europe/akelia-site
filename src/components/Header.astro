---
// =========================================================================
// COMPOSANT HEADER (src/components/Header.astro)
// -------------------------------------------------------------------------
// En-tête de toutes les pages : logo, méga-menu des solutions, liens
// secondaires et bouton « Obtenir un devis ».
//
// Principes :
// - 100 % Tailwind, uniquement avec les couleurs de la charte
//   (src/styles/global.css) : nuit, action, creme, texte-doux, fond,
//   texte. Aucune couleur Tailwind par défaut (slate, emerald…).
// - Mobile d'abord : sous 1280px (breakpoint xl), un bouton « Menu » ouvre
//   un tiroir latéral. À partir de 1280px, le méga-menu s'affiche.
//   Pourquoi 1280px et pas 992px : en dessous, les libellés du menu ne
//   tiennent plus sur une ligne (ils se coupent en deux, ce qui fait
//   négligé), et sur tablette en paysage le tiroir est plus confortable
//   au doigt.
// - Public senior, souvent sur tablette : tout élément cliquable mesure au
//   moins 44px de haut (classes min-h-11 = 44px, ou min-h-12 = 48px).
// - Méga-menu hybride : ouverture au SURVOL avec une souris (délai de
//   fermeture de 200ms pour ne pas le perdre en chemin), au CLIC sur écran
//   tactile, et au clavier (Entrée, Espace, Échap, Tab).
// - Le panneau du méga-menu prolonge le Header (même fond blanc, pleine
//   largeur, sans ombre ni arrondi) ; l'onglet ouvert est signalé par un
//   soulignement orange épais et une graisse 600.
//
// Pour modifier le menu : il suffit d'éditer le tableau `menuSolutions`
// de src/data/menu.ts. Le menu ordinateur ET le tiroir mobile se mettent à jour
// ensemble.
// =========================================================================

import { Image } from 'astro:assets';

// Données du menu (méga-menu, liens directs, liens secondaires) :
// src/data/menu.ts, partagé avec les pages qui renvoient vers ses
// rubriques.
import { menuSolutions, liensDirects, liensSecondaires } from '../data/menu';

// -------------------------------------------------------------------------
// PAGE EN COURS
// Sert à signaler aux lecteurs d'écran (aria-current) et visuellement le
// lien de la page sur laquelle on se trouve.
// -------------------------------------------------------------------------
const cheminActuel = Astro.url.pathname.replace(/\/$/, '') || '/';
const estPageActuelle = (href: string) => cheminActuel === href;
---

{/* =========================================================================
    LIEN D'ÉVITEMENT
    Invisible tant qu'on ne navigue pas au clavier : permet de sauter le
    menu et d'aller directement au contenu (exigence d'accessibilité).
========================================================================== */}
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:inline-flex focus:min-h-12 focus:items-center focus:rounded-bloc focus:bg-nuit-900 focus:px-5 focus:text-texte-inverse"
>
  Aller au contenu
</a>

{/* =========================================================================
    EN-TÊTE
    - sticky top-0 : reste visible pendant le défilement.
    - relative : sert de repère au panneau du méga-menu, qui s'ouvre
      juste en dessous, sur toute la largeur.
========================================================================== */}
<header id="site-header" class="sticky top-0 z-50 border-b border-creme-fonce bg-fond">
  <div class="mx-auto max-w-site px-gouttiere">

    {/* ---------------------------------------------------------------------
        LIGNE 1 : logo, liens secondaires (ordinateur), bouton devis,
        bouton « Menu » (mobile et tablette).
    ---------------------------------------------------------------------- */}
    <div class="flex min-h-18 items-center justify-between gap-4">

      {/* LOGO : retour à l'accueil */}
      <a
        href="/"
        aria-label="Akelia, retour à l'accueil"
        class="inline-flex min-h-12 items-center rounded-bloc text-h3 font-bold text-nuit-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900"
      >
        Akelia
      </a>

      <div class="flex items-center gap-2 xl:gap-6">

        {/* LIENS SECONDAIRES : visibles à partir de 1280px uniquement */}
        <nav aria-label="Informations" class="hidden xl:block">
          <ul class="flex items-center gap-1">
            {liensSecondaires.map((lien) => (
              <li>
                <a
                  href={lien.href}
                  aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
                  class="inline-flex min-h-11 items-center rounded-bloc px-3 text-base text-texte-doux underline-offset-4 hover:bg-creme hover:text-nuit-900 aria-[current=page]:font-semibold aria-[current=page]:text-nuit-900 aria-[current=page]:underline focus-visible:outline-2 focus-visible:outline-nuit-900"
                >
                  {lien.nom}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/* BOUTON D'ACTION : toujours visible, même sur téléphone.
            Sur les très petits écrans (moins de 360px), seul le mot « Devis »
            s'affiche pour que le bouton tienne sur une ligne ; les lecteurs
            d'écran annoncent toujours « Obtenir un devis ». */}
        <a
          href="/devis"
          class="inline-flex min-h-12 items-center whitespace-nowrap rounded-bloc bg-action-500 px-4 text-base font-semibold text-texte shadow-legere hover:bg-action-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900 sm:px-5"
        >
          <span class="max-[22.5rem]:sr-only">Obtenir un&nbsp;</span>
          <span class="min-[22.5rem]:hidden">Devis</span>
          <span class="max-[22.5rem]:hidden">devis</span>
        </a>

        {/* BOUTON « MENU » : ouvre le tiroir latéral, masqué à partir de 1280px */}
        <button
          type="button"
          id="tiroir-ouvrir"
          aria-controls="tiroir-mobile"
          aria-expanded="false"
          class="inline-flex min-h-12 min-w-12 flex-col items-center justify-center rounded-bloc text-nuit-900 hover:bg-creme focus-visible:outline-2 focus-visible:outline-nuit-900 xl:hidden"
        >
          <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          {/* Le mot « Menu » sous l'icône aide les personnes qui ne
              reconnaissent pas l'icône « burger ». */}
          <span class="text-legende font-semibold">Menu</span>
        </button>
      </div>
    </div>

    {/* ---------------------------------------------------------------------
        LIGNE 2 : MÉGA-MENU (ordinateur, à partir de 1280px)
        - 3 entrées déroulantes, puis 2 liens directs (sans sous-menu).
        - Un seul panneau ouvert à la fois.
        - Ouverture : au SURVOL avec une souris, au CLIC sur écran tactile,
          avec Entrée ou Espace au clavier (voir le script en bas du fichier).
        - Fermeture : la souris quitte l'entrée (après 200ms), nouveau clic,
          touche Échap, clic ailleurs, ou focus clavier sorti du menu.
    ---------------------------------------------------------------------- */}
    <nav id="mega-nav" aria-label="Nos solutions" class="hidden border-t border-creme-fonce xl:block">
      <ul class="flex items-stretch gap-1">
        {menuSolutions.map((entree) => (
          <li data-mega-entree>
            {/* ONGLET : fond blanc en permanence.
                - Fermé : texte en graisse 400, soulignement transparent.
                - Ouvert (aria-expanded) : soulignement orange de 4px et
                  graisse 600. Le soulignement touche le haut du panneau :
                  onglet et panneau forment un seul bloc.
                - Le libellé est écrit deux fois, superposés : la copie
                  invisible en graisse 600 réserve la largeur, pour que les
                  onglets ne bougent pas quand la graisse change. */}
            <button
              type="button"
              data-mega-bouton
              aria-expanded="false"
              aria-controls={`mega-${entree.id}`}
              class="group inline-flex min-h-12 items-center gap-2 border-b-4 border-transparent px-3 text-base text-nuit-900 aria-expanded:border-action-500 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-nuit-900"
            >
              <span class="grid">
                <span aria-hidden="true" class="invisible col-start-1 row-start-1 font-semibold">{entree.titre}</span>
                <span class="col-start-1 row-start-1 font-normal group-aria-expanded:font-semibold">{entree.titre}</span>
              </span>
              {/* Chevron : pivote quand le panneau est ouvert */}
              <svg class="size-5 transition-transform group-aria-expanded:rotate-180 motion-reduce:transition-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            {/* PANNEAU DU MÉGA-MENU : prolongement du Header, pas une popup.
                - absolute inset-x-0 top-full : part exactement du bas du
                  Header (il recouvre son trait gris) et occupe toute la
                  largeur de l'écran.
                - Même fond blanc que le Header, sans arrondi.
                - Filet crème foncé et ombre portée en bas (plus de trait
                  noir depuis la refonte d'octobre 2026). */}
            <div
              id={`mega-${entree.id}`}
              hidden
              class="absolute inset-x-0 top-full border-b border-creme-fonce bg-fond shadow-carte"
            >
              <div class="mx-auto grid max-w-site grid-cols-4 gap-bloc px-gouttiere pt-6 pb-bloc">
                {entree.groupes.map((groupe) => (
                  <div>
                    {/* IMAGE DE LA SOUS-CATÉGORIE (bannière 350 × 120, reprise
                        du site d'origine). Elle illustre seulement : hauteur
                        limitée à 96px, et alt="" car le titre juste en
                        dessous dit déjà de quoi il s'agit. Si une image
                        manque, l'espace reste vide (aucune image générique). */}
                    <div class="mb-3 aspect-[350/120] max-h-24 w-full bg-creme">
                      {groupe.image && (
                        <Image src={groupe.image} alt="" width={350} height={120} class="h-full w-full object-cover" />
                      )}
                    </div>
                    {/* Titre de colonne (non cliquable) */}
                    <p class="mb-2 border-b-2 border-action-500 pb-2 text-h4 text-nuit-900">
                      {groupe.titre}
                    </p>
                    <ul>
                      {groupe.liens.map((lien) => (
                        <li>
                          <a
                            href={lien.href}
                            aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
                            class="flex min-h-11 items-center rounded-bloc px-2 text-corps text-texte hover:bg-creme hover:text-nuit-900 aria-[current=page]:font-semibold aria-[current=page]:text-nuit-900 focus-visible:outline-2 focus-visible:outline-nuit-900"
                          >
                            {lien.nom}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </li>
        ))}

        {/* LIENS DIRECTS (sans sous-menu), après les 3 entrées déroulantes.
            Même style que les onglets : fond blanc, graisse 400, soulignement
            orange au survol et sur la page en cours (avec graisse 600). */}
        {liensDirects.map((lien) => lien.enAvant ? (
          /* ENTRÉE MISE EN AVANT (« Construction neuve ») : étiquette verte
             (vert-600 sur vert-50 : 5,59:1 ; au survol vert-100 : 5,04:1),
             44px de haut, 12px d'écart avec sa voisine. Page en cours :
             soulignée. */
          <li class="ml-3 flex items-center">
            <a
              href={lien.href}
              aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
              class="inline-flex min-h-11 items-center whitespace-nowrap rounded-lg bg-vert-50 px-4 text-base font-semibold text-vert-600 underline-offset-4 hover:bg-vert-100 aria-[current=page]:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900"
            >
              {lien.nom}
            </a>
          </li>
        ) : (
          <li>
            <a
              href={lien.href}
              aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
              class="group inline-flex min-h-12 items-center border-b-4 border-transparent px-3 text-base text-nuit-900 hover:border-action-500 aria-[current=page]:border-action-500 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-nuit-900"
            >
              <span class="grid">
                <span aria-hidden="true" class="invisible col-start-1 row-start-1 font-semibold">{lien.nom}</span>
                <span class="col-start-1 row-start-1 font-normal group-aria-[current=page]:font-semibold">{lien.nom}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

{/* =========================================================================
    TIROIR LATÉRAL (téléphone, tablette et petit ordinateur, sous 1280px)
    - Placé hors du <header> pour couvrir tout l'écran.
    - Fermé : « invisible » le retire de la navigation clavier et des
      lecteurs d'écran.
    - Ouvert : le script ajoute l'attribut data-open, ce qui active toutes
      les classes « group-data-open:… » (fond assombri, tiroir qui glisse).
========================================================================== */}
<div id="tiroir-mobile" class="group invisible fixed inset-0 z-50 data-open:visible xl:hidden">

  {/* Fond assombri : un clic dessus ferme le tiroir */}
  <div
    data-tiroir-fermer
    class="absolute inset-0 bg-nuit-900/60 opacity-0 transition-opacity group-data-open:opacity-100 motion-reduce:transition-none"
    aria-hidden="true"
  ></div>

  {/* Panneau du tiroir, qui glisse depuis la droite */}
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Menu principal"
    class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col bg-fond shadow-elevee transition-transform group-data-open:translate-x-0 motion-reduce:transition-none"
  >
    {/* En-tête du tiroir : titre + bouton fermer */}
    <div class="flex min-h-18 items-center justify-between border-b border-creme-fonce px-gouttiere">
      <p class="text-h4 text-nuit-900">Menu</p>
      <button
        type="button"
        id="tiroir-fermer"
        data-tiroir-fermer
        class="inline-flex min-h-12 items-center gap-2 rounded-bloc px-3 font-semibold text-nuit-900 hover:bg-creme focus-visible:outline-2 focus-visible:outline-nuit-900"
      >
        Fermer
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Contenu défilant du tiroir */}
    <nav aria-label="Menu principal" class="flex-1 overflow-y-auto px-gouttiere py-6">

      {/* SOLUTIONS : un accordéon par entrée du méga-menu.
          <details> fonctionne sans JavaScript. */}
      <ul class="space-y-2">
        {menuSolutions.map((entree) => (
          <li>
            <details class="group/accordeon rounded-bloc border border-creme-fonce open:bg-creme">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 rounded-bloc px-4 text-corps font-semibold text-nuit-900 focus-visible:outline-2 focus-visible:outline-nuit-900 [&::-webkit-details-marker]:hidden">
                {entree.titre}
                <svg class="size-6 shrink-0 transition-transform group-open/accordeon:rotate-180 motion-reduce:transition-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="space-y-4 px-4 pb-4">
                {entree.groupes.map((groupe) => (
                  <div>
                    <p class="pt-2 text-petit font-semibold uppercase tracking-wide text-texte-doux">
                      {groupe.titre}
                    </p>
                    <ul>
                      {groupe.liens.map((lien) => (
                        <li>
                          <a
                            href={lien.href}
                            aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
                            class="flex min-h-12 items-center rounded-bloc px-2 text-corps text-texte hover:bg-fond aria-[current=page]:font-semibold aria-[current=page]:text-nuit-900 focus-visible:outline-2 focus-visible:outline-nuit-900"
                          >
                            {lien.nom}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          </li>
        ))}
      </ul>

      {/* LIENS DIRECTS (« Rénovation globale », « Construction neuve ») :
          après les 3 accordéons, avant les liens secondaires. Même cadre que les accordéons, car ils
          sont du même niveau dans le menu ; une flèche remplace le chevron
          pour montrer qu'ils ouvrent directement une page. « Construction
          neuve » est mis en avant : fond vert-50, texte vert-600, coins
          arrondis comme le badge du Hero. */}
      <ul class="mt-2 space-y-2">
        {liensDirects.map((lien) => (
          <li>
            <a
              href={lien.href}
              aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
              class={lien.enAvant
                ? 'flex min-h-14 items-center justify-between gap-3 rounded-lg border border-vert-50 bg-vert-50 px-4 text-corps font-semibold text-vert-600 underline-offset-4 hover:border-vert-100 hover:bg-vert-100 aria-[current=page]:underline focus-visible:outline-2 focus-visible:outline-nuit-900'
                : 'flex min-h-14 items-center justify-between gap-3 rounded-bloc border border-creme-fonce px-4 text-corps font-semibold text-nuit-900 hover:bg-creme aria-[current=page]:border-action-500 aria-[current=page]:bg-action-50 focus-visible:outline-2 focus-visible:outline-nuit-900'}
            >
              {lien.nom}
              <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      {/* LIENS SECONDAIRES */}
      <ul class="mt-6 border-t border-creme-fonce pt-4">
        {liensSecondaires.map((lien) => (
          <li>
            <a
              href={lien.href}
              aria-current={estPageActuelle(lien.href) ? 'page' : undefined}
              class="flex min-h-12 items-center rounded-bloc px-4 text-corps text-texte hover:bg-creme aria-[current=page]:font-semibold aria-[current=page]:text-nuit-900 focus-visible:outline-2 focus-visible:outline-nuit-900"
            >
              {lien.nom}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* BOUTON D'ACTION en bas du tiroir, toujours accessible */}
    <div class="border-t border-creme-fonce p-gouttiere">
      <a
        href="/devis"
        class="flex min-h-14 w-full items-center justify-center rounded-bloc bg-action-500 px-5 text-corps font-semibold text-texte shadow-legere hover:bg-action-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900"
      >
        Obtenir un devis
      </a>
    </div>
  </div>
</div>

<script>
  // =========================================================================
  // COMPORTEMENTS DU HEADER
  // 1. Méga-menu (ordinateur) : survol à la souris, clic au toucher,
  //    clavier ; un panneau à la fois.
  // 2. Tiroir latéral (mobile/tablette) : ouverture, fermeture, focus.
  // =========================================================================

  // ---------------------------------------------------------------------------
  // 1. MÉGA-MENU : comportement hybride
  // - Souris (écran qui gère le survol ET pointeur précis) : le panneau
  //   s'ouvre au survol de l'entrée et se referme 200ms après que la souris
  //   l'a quittée. Ce délai évite une fermeture intempestive quand la souris
  //   passe du bouton au panneau.
  // - Écran tactile : ouverture et fermeture au toucher (clic).
  // - Clavier : Entrée ou Espace ouvre/ferme, Échap ferme, et le panneau se
  //   ferme quand le focus quitte le menu.
  // ---------------------------------------------------------------------------
  const boutonsMega = document.querySelectorAll<HTMLButtonElement>('[data-mega-bouton]');
  const survolPossible = window.matchMedia('(hover: hover) and (pointer: fine)');
  const DELAI_FERMETURE = 200; // en millisecondes
  let minuteurFermeture: number | undefined;

  /** Renvoie le panneau commandé par un bouton du méga-menu. */
  function panneauDe(bouton: HTMLButtonElement) {
    return document.getElementById(bouton.getAttribute('aria-controls')!);
  }

  /** Ferme tous les panneaux du méga-menu. */
  function fermerMega() {
    window.clearTimeout(minuteurFermeture);
    boutonsMega.forEach((bouton) => {
      bouton.setAttribute('aria-expanded', 'false');
      const panneau = panneauDe(bouton);
      if (panneau) panneau.hidden = true;
    });
  }

  /** Ouvre le panneau d'un bouton (et ferme les autres). */
  function ouvrirMega(bouton: HTMLButtonElement) {
    fermerMega();
    bouton.setAttribute('aria-expanded', 'true');
    const panneau = panneauDe(bouton);
    if (panneau) panneau.hidden = false;
  }

  boutonsMega.forEach((bouton) => {
    // CLIC / TOUCHER / CLAVIER
    bouton.addEventListener('click', (evenement) => {
      // Avec une souris, le panneau est déjà ouvert par le survol : un clic
      // ne doit pas le refermer. (evenement.detail vaut 0 quand le « clic »
      // vient du clavier : dans ce cas, on bascule normalement.)
      if (survolPossible.matches && evenement.detail > 0) {
        ouvrirMega(bouton);
        return;
      }
      const dejaOuvert = bouton.getAttribute('aria-expanded') === 'true';
      if (dejaOuvert) fermerMega();
      else ouvrirMega(bouton);
    });

    // SURVOL À LA SOURIS : écouté sur l'entrée entière (bouton + panneau),
    // pour que le panneau reste ouvert tant que la souris est dessus.
    const entree = bouton.closest<HTMLElement>('[data-mega-entree]');
    entree?.addEventListener('pointerenter', (evenement) => {
      if (evenement.pointerType !== 'mouse' || !survolPossible.matches) return;
      window.clearTimeout(minuteurFermeture);
      if (bouton.getAttribute('aria-expanded') !== 'true') ouvrirMega(bouton);
    });
    entree?.addEventListener('pointerleave', (evenement) => {
      if (evenement.pointerType !== 'mouse' || !survolPossible.matches) return;
      window.clearTimeout(minuteurFermeture);
      minuteurFermeture = window.setTimeout(fermerMega, DELAI_FERMETURE);
    });
  });

  // Clic en dehors du header : on referme le méga-menu.
  document.addEventListener('click', (evenement) => {
    const header = document.getElementById('site-header');
    if (header && !header.contains(evenement.target as Node)) fermerMega();
  });

  // Focus clavier sorti du menu (Tab après le dernier lien) : on referme.
  document.getElementById('mega-nav')?.addEventListener('focusout', (evenement) => {
    const nav = evenement.currentTarget as HTMLElement;
    if (!nav.contains(evenement.relatedTarget as Node | null)) fermerMega();
  });

  // ---------------------------------------------------------------------------
  // 2. TIROIR LATÉRAL
  // ---------------------------------------------------------------------------
  const tiroir = document.getElementById('tiroir-mobile');
  const boutonOuvrir = document.getElementById('tiroir-ouvrir');
  const boutonFermer = document.getElementById('tiroir-fermer');

  function ouvrirTiroir() {
    if (!tiroir || !boutonOuvrir) return;
    tiroir.setAttribute('data-open', '');
    boutonOuvrir.setAttribute('aria-expanded', 'true');
    // Empêche la page de défiler derrière le tiroir.
    document.documentElement.classList.add('overflow-hidden');
    // Place le focus sur « Fermer » pour les utilisateurs du clavier.
    boutonFermer?.focus();
  }

  function fermerTiroir() {
    if (!tiroir || !boutonOuvrir || !tiroir.hasAttribute('data-open')) return;
    tiroir.removeAttribute('data-open');
    boutonOuvrir.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('overflow-hidden');
    // Rend le focus au bouton « Menu ».
    boutonOuvrir.focus();
  }

  boutonOuvrir?.addEventListener('click', ouvrirTiroir);
  document.querySelectorAll('[data-tiroir-fermer]').forEach((element) => {
    element.addEventListener('click', fermerTiroir);
  });

  // Si l'écran est agrandi au-delà de 1280px (tablette tournée, fenêtre
  // élargie), le tiroir n'a plus lieu d'être : on le ferme.
  window.matchMedia('(width >= 80rem)').addEventListener('change', (requete) => {
    if (requete.matches) fermerTiroir();
  });

  // ---------------------------------------------------------------------------
  // TOUCHE ÉCHAP : ferme le méga-menu ou le tiroir, selon ce qui est ouvert.
  // ---------------------------------------------------------------------------
  document.addEventListener('keydown', (evenement) => {
    if (evenement.key !== 'Escape') return;
    const boutonOuvert = document.querySelector<HTMLButtonElement>('[data-mega-bouton][aria-expanded="true"]');
    if (boutonOuvert) {
      fermerMega();
      boutonOuvert.focus();
    }
    fermerTiroir();
  });
</script>
