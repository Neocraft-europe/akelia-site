---
// =========================================================================
// COMPOSANT : ICÔNES DE LA PAGE DES AIDES (src/components/aides/Icone.astro)
// -------------------------------------------------------------------------
// Pictogrammes au trait (24 × 24, trait de 1,75), couleur du texte
// environnant (currentColor). Toujours décoratifs (aria-hidden) : le nom
// du poste est écrit à côté.
// Utilisés par les vignettes de travaux et les encadrés de
// /aides-renovation, /qui-sommes-nous (engagements, domaines) et
// /rejoindre-le-collectif, et les pages /solutions/… (feuille, son et
// engrenage ajoutés le 19 octobre 2026 pour la PAC air-eau).
// =========================================================================

export type NomIcone =
  | 'isolation' | 'fenetre' | 'pompe-a-chaleur' | 'climatisation' | 'bois' | 'chauffe-eau'
  | 'solaire' | 'ventilation' | 'borne' | 'audit' | 'soleil' | 'assainissement' | 'regulation'
  | 'reseau' | 'chauffage' | 'maison' | 'note' | 'alerte' | 'avantage' | 'valide'
  | 'technicien' | 'repere' | 'prix' | 'valorisation' | 'calendrier' | 'plan'
  | 'feuille' | 'son' | 'engrenage';

export interface Props {
  nom: NomIcone;
  class?: string;
}

const { nom, class: classes = 'size-8' } = Astro.props;

// Tracés de chaque icône (éléments SVG, sans le cadre <svg>).
