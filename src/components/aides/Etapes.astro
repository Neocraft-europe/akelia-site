---
// =========================================================================
// COMPOSANT : ÉTAPES NUMÉROTÉES (src/components/aides/Etapes.astro)
// -------------------------------------------------------------------------
// « Comment en bénéficier ? » sur /aides-renovation, dans le style des
// étapes de /devis : pastille blanche cerclée d'orange, filet orange entre
// les pastilles. `titre` : mot d'entrée en gras (« Réaliser un
// diagnostic : »), `texte` : la suite, mot pour mot.
// =========================================================================

export interface Etape {
  titre: string;
  texte: string;
}

export interface Props {
  etapes: Etape[];
}

const { etapes } = Astro.props;
---

<ol class="mt-6">
  {etapes.map((etape, index) => (
    <li class="relative flex gap-5 pb-8 last:pb-0">
      {index < etapes.length - 1 && (
        <span aria-hidden="true" class="absolute top-12 bottom-2 left-5 w-0.5 -translate-x-1/2 bg-action-500/60"></span>
      )}
      <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-pilule border-2 border-action-500 bg-fond text-h4 font-bold text-nuit-900">
        {index + 1}
      </span>
      <p class="min-w-0 pt-1 text-corps text-texte">
        <span class="sr-only">Étape {index + 1} : </span><strong class="font-semibold">{etape.titre}</strong> {etape.texte}
      </p>
    </li>
  ))}
</ol>
