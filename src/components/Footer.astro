---
// =========================================================================
// COMPOSANT FOOTER (src/components/Footer.astro)
// Objectif : Pied de page minimaliste, sémantique et conforme aux exigences légales
// =========================================================================

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold text-emerald-600">AKELIA</span>
        <span class="text-xs text-slate-500">© {currentYear} Akelia. Tous droits réservés.</span>
      </div>

      <nav class="flex flex-wrap items-center gap-6 text-sm text-slate-600">
        <a href="/services" class="hover:text-emerald-600 transition-colors">Services</a>
        <a href="/aides-renovation" class="hover:text-emerald-600 transition-colors">Aides</a>
        <a href="/blog" class="hover:text-emerald-600 transition-colors">Blog</a>
        <a href="/qui-sommes-nous" class="hover:text-emerald-600 transition-colors">L'équipe</a>
        <a href="/mentions-legales" class="hover:text-emerald-600 transition-colors">Mentions légales</a>
      </nav>
    </div>
  </div>
</footer>
