      <path class="trait" d="M336 438c-2.8 0-4.6-1.9-4.6-4.3 0-2.8 2.6-4.3 4.6-7.7 2 3.4 4.6 4.9 4.6 7.7 0 2.4-1.8 4.3-4.6 4.3Z" />
      <path class="trait plein" d="M253 346L286.8 327.8L286.8 297.8L253 316ZM256.9 340.9L256.9 316.9M261.4 338.4L261.4 314.4M266 336L266 312M270.6 333.6L270.6 309.6M275.1 331.1L275.1 307.1M279.7 328.6L279.7 304.6" />
      <path class="rappel" d="M432 520 L357 457" />
      <circle class="repere" cx="440" cy="528" r="8" />
    </g>

    {/* 6. PANNEAUX PHOTOVOLTAÏQUES : 2 rangées de 3 modules sur le pan droit, cellules en trait fin */}
