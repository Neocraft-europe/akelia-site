{/* Script minimal, écrit juste après le schéma pour s'exécuter avant le
    premier affichage (pas de clignotement). Un seul rôle depuis la
    suppression de la légende (14 octobre 2026) : l'ANIMATION.
       - si « réduire les animations » est actif, ou si le navigateur ne
         sait pas détecter l'entrée à l'écran : rien (état final) ;
       - sinon : état « attente » (contours invisibles), puis « anime » dès
         que 30 % du schéma est visible. Quand le schéma a ENTIÈREMENT
         quitté l'écran, il repasse en « attente » ; l'animation se rejoue
         au retour suivant. */}
<script is:inline>
  (function () {
    var schema = document.currentScript.previousElementSibling;
    if (!schema) return;

    // ANIMATION, rejouée à chaque retour à l'écran
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    schema.setAttribute('data-etat', 'attente');
    // arme : vrai au départ, puis seulement après une sortie complète.
    var arme = true;
    new IntersectionObserver(function (entrees) {
      var e = entrees[entrees.length - 1];
      if (!e.isIntersecting) {
        // Entièrement hors de l'écran : retour à l'état initial (invisible,
        // sans effet puisque hors écran) et réarmement.
        schema.setAttribute('data-etat', 'attente');
        arme = true;
        return;
      }
      var visible = e.intersectionRatio >= 0.3 || e.intersectionRect.height >= 0.3 * window.innerHeight;
      if (visible && arme) {
        arme = false;
        schema.setAttribute('data-etat', 'attente');
        void schema.offsetWidth; // applique l'état initial avant de relancer
        schema.setAttribute('data-etat', 'anime');
      }
    }, { threshold: [0, 0.1, 0.2, 0.3] }).observe(schema);
  })();
</script>

<style>
  /* =======================================================================
     ÉPAISSEURS DE TRAIT
     Le dessin (viewBox de 920 de large) est réduit selon l'écran. Pour
     garder à l'écran environ 2px (structure), 1.5px (équipements) et 1px
     (cotes, rappels), les épaisseurs sont exprimées en unités du dessin :
     - téléphone (schéma d'environ 335px de large, échelle ≈ 0,36) ;
     - à partir de 768px (environ 700px, échelle ≈ 0,76, sur tablette comme
       dans la colonne de droite du grand écran).
  ======================================================================= */
  .schema-maison {
    --t-structure: 5;
    --t-equip: 3.8;
    --t-fin: 2.4;
    --echelle-repere: 2.2;
  }
  @media (width >= 48rem) {
    .schema-maison { --t-structure: 2.6; --t-equip: 2; --t-fin: 1.3; --echelle-repere: 1.15; }
  }
  @media (width >= 80rem) {
    .schema-maison { --t-structure: 2.6; --t-equip: 2; --t-fin: 1.3; --echelle-repere: 1.3; }
  }
  .structure path {
    fill: none;
    stroke: var(--color-marque-900);
    stroke-width: var(--t-structure);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .structure .masque { fill: var(--color-fond); stroke: none; }
  .structure .fin, .structure .section { stroke-width: var(--t-equip); }
  .structure .section { fill: var(--color-fond); }
  .structure .tuiles { stroke: var(--color-neutre-500); stroke-width: var(--t-fin); }
  .trait {
    fill: none;
    stroke: var(--color-marque-900);
    stroke-width: var(--t-equip);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trait.plein { fill: var(--color-fond); }
  .hachure { fill: url(#hachure); }
  .hachure-trait { stroke: var(--color-marque-900); stroke-width: calc(var(--t-fin) * 0.8); }
  .hachure-trait-action { stroke: var(--color-action-500); }
  .gaine { stroke-dasharray: 6 5; }
  .trait.cellule { stroke-width: calc(var(--t-equip) * 0.6); }
  .rappel, .cote, .cote-rappel {
    fill: none;
    stroke: var(--color-neutre-500);
    stroke-width: var(--t-fin);
  }
  .cote { marker-start: url(#fleche-cote); marker-end: url(#fleche-cote); }
  .fleche { fill: none; stroke: var(--color-neutre-500); stroke-width: 1.5; }
  /* Annotations « manuscrites » (« R ≥ 7 », « local technique ») :
     Source Sans 3 italique, 22 unités du dessin, soit environ 16px à
     l'écran à partir de 768px (masquées sur téléphone). */
  .manuscrit {
    fill: var(--color-neutre-500);
    font-family: var(--font-base);
    font-size: 22px;
    font-style: italic;
    text-anchor: start;
  }
  /* Repères : pastilles orange pleines (sans numéro depuis le 14 octobre
     2026), cerclées de blanc pour se détacher des traits qu'elles touchent. */
  .repere {
    transform-box: fill-box;
    transform-origin: center;
    scale: var(--echelle-repere);
    fill: var(--color-action-500);
    stroke: var(--color-fond);
    stroke-width: 2;
  }
  @media (width < 48rem) {
    .detail { display: none; }
  }

  /* =======================================================================
     ANIMATIONS (déclenchées par le script, rejouées à chaque retour)
  ======================================================================= */
  /* En attente : contours non tracés, équipements et cotes invisibles */
  .schema-maison[data-etat='attente'] .structure path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .schema-maison[data-etat='attente'] :is(.equip, .cotes) { opacity: 0; }

  /* 1. Tracé du bâtiment : 1,2 s, comme un crayon */
  .schema-maison[data-etat='anime'] .structure path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: schema-trace 1.2s ease-in-out forwards;
  }
  @keyframes schema-trace { to { stroke-dashoffset: 0; } }

  /* 2. Apparition des équipements : après le tracé, 80 ms d'écart, dans
        l'ordre de la méthode (--rang). Les cotes viennent en dernier. */
  .schema-maison[data-etat='anime'] .equip {
    opacity: 0;
    animation: schema-apparition 0.3s ease-out forwards;
    animation-delay: calc(1.2s + var(--rang) * 80ms);
  }
  .schema-maison[data-etat='anime'] .cotes {
    opacity: 0;
    animation: schema-apparition 0.3s ease-out forwards;
    animation-delay: calc(1.2s + 8 * 80ms);
  }
  @keyframes schema-apparition { to { opacity: 1; } }

  /* Réduire les animations : tout à l'état final, sans aucun mouvement */
  @media (prefers-reduced-motion: reduce) {
    .schema-maison .structure path,
    .schema-maison .equip,
    .schema-maison .cotes {
      animation: none !important;
      stroke-dasharray: none !important;
      opacity: 1 !important;
    }
  }

  /* =======================================================================
     3. ÉQUIPEMENTS MASQUÉS ET ALLUMAGE (attribut data-allume, posé par le
        Hero ; voir l'en-tête du fichier)
     - visibility (et non opacity) : l'animation d'apparition règle déjà
       l'opacité, elle écraserait le masquage.
     - L'équipement allumé passe en orange, trait doublé, sans transition.
       Les deux variables --equip-trait et --equip-epaisseur évitent de
       répéter la liste des équipements pour chaque propriété.
  ======================================================================= */
  .equip-masque { visibility: hidden; }
  .schema-maison:is([data-allume~='pompe-a-chaleur'], [data-allume='tout']) #pompe-a-chaleur,
  .schema-maison[data-allume~='climatisation'] #climatisation,
  .schema-maison[data-allume~='chaudiere-biomasse'] #chaudiere-biomasse {
    visibility: visible;
  }

  .equip .trait {
    stroke: var(--equip-trait, var(--color-marque-900));
    stroke-width: var(--equip-epaisseur, var(--t-equip));
  }
  .equip .trait.cellule { stroke-width: calc(var(--equip-epaisseur, var(--t-equip)) * 0.6); }
  .equip .hachure { fill: var(--equip-hachure, url(#hachure)); }
  .schema-maison[data-allume='tout'] .equip,
  .schema-maison[data-allume~='isolation-combles'] #isolation-combles,
  .schema-maison[data-allume~='isolation-murs'] #isolation-murs,
  .schema-maison[data-allume~='menuiseries'] #menuiseries,
  .schema-maison[data-allume~='ventilation'] #ventilation,
  .schema-maison[data-allume~='pompe-a-chaleur'] #pompe-a-chaleur,
  .schema-maison[data-allume~='climatisation'] #climatisation,
  .schema-maison[data-allume~='chaudiere-biomasse'] #chaudiere-biomasse,
  .schema-maison[data-allume~='panneaux-photovoltaiques'] #panneaux-photovoltaiques,
  .schema-maison[data-allume~='chauffe-eau'] #chauffe-eau,
  .schema-maison[data-allume~='borne-de-recharge'] #borne-de-recharge {
    --equip-trait: var(--color-action-500);
    --equip-epaisseur: calc(var(--t-equip) * 2);
    --equip-hachure: url(#hachure-action);
  }
</style>
