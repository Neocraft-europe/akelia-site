---
// =========================================================================
// COMPOSANT ARTICLELIST (src/components/ArticleList.astro)
// Objectif : Affiche les 3 derniers articles, filtrables selon une catégorie
// Cartes blanches bordées d'un filet crème foncé (16 octobre 2026) : la
// section des articles est désormais blanche, comme les cartes.
// =========================================================================

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { blogCategories } from '../content.config';

export interface Props {
  // Catégorie facultative : si fournie, filtre strictement par cette catégorie
  category?: (typeof blogCategories)[number];
}

const { category } = Astro.props;

// Récupération de tous les articles du blog
const allPosts = await getCollection('blog');

// Filtrage éventuel par catégorie et tri antichronologique (du plus récent au plus vieux)
const filteredPosts = allPosts
  .filter((post) => (category ? post.data.category === category : true))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3); // Limite stricte aux 3 derniers articles
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {filteredPosts.length === 0 ? (
    <p class="col-span-full py-6 text-center text-texte-doux">
      Aucun article disponible dans cette section pour le moment.
    </p>
  ) : (
    filteredPosts.map((post) => (
      <article class="flex flex-col overflow-hidden rounded-bloc border border-creme-fonce bg-fond transition-shadow hover:shadow-carte motion-reduce:transition-none">
        {/* Image optimisée via le composant natif Astro Image */}
        <div class="aspect-video w-full overflow-hidden bg-creme-fonce">
          <Image
            src={post.data.coverImage}
            alt={post.data.title}
            width={600}
            height={338}
            format="webp"
            class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
            loading="lazy"
          />
        </div>

        <div class="flex flex-1 flex-col justify-between p-5">
          <div>
            <span class="surtitre">
              {post.data.category}
            </span>
            <h3 class="mt-2 line-clamp-2 text-h4 font-black text-texte">
              <a href={`/blog/${post.id}`} class="hover:text-vert-600">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 line-clamp-3 text-corps text-texte-doux">
              {post.data.description}
            </p>
          </div>

          <div class="mt-4 flex items-center justify-between text-petit text-texte-doux">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <a href={`/blog/${post.id}`} class="font-semibold text-vert-600 hover:underline">
              Lire la suite →
            </a>
          </div>
        </div>
      </article>
    ))
  )}
</div>
