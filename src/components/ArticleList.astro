---
// =========================================================================
// COMPOSANT ARTICLELIST (src/components/ArticleList.astro)
// Objectif : Affiche les 3 derniers articles, filtrables selon une catégorie
// Cartes blanches bordées d'un filet crème foncé (16 octobre 2026) : la
// section des articles est désormais blanche, comme les cartes.
// 17 octobre 2026 : la carte est dans CarteArticle.astro (réutilisée par
// les articles liés), brouillons exclus, nouveaux champs du blog.
// =========================================================================

import CarteArticle from './CarteArticle.astro';
import { articlesPublies } from '../utils/blog';
import type { CategorieBlog } from '../data/categories-blog';

export interface Props {
  // Catégorie facultative : si fournie, filtre strictement par cette catégorie
  category?: CategorieBlog;
}

const { category } = Astro.props;

// Les 3 articles publiés les plus récents (de la catégorie, si fournie)
const filteredPosts = (await articlesPublies())
  .filter((post) => (category ? post.data.categorie === category : true))
  .slice(0, 3);
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {filteredPosts.length === 0 ? (
    <p class="col-span-full py-6 text-center text-texte-doux">
      Aucun article disponible dans cette section pour le moment.
    </p>
  ) : (
    filteredPosts.map((post) => <CarteArticle article={post} />)
  )}
</div>
