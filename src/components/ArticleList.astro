---
// =========================================================================
// COMPOSANT ARTICLELIST (src/components/ArticleList.astro)
// Objectif : Affiche les 3 derniers articles, filtrables selon une catégorie
// =========================================================================

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { blogCategories } from '../content/config';

export interface Props {
  // Catégorie facultative : si fournie, filtre strictement par cette catégorie
  category?: (typeof blogCategories)[number];
}

const { category } = Astro.props;

// Récupération de tous les articles du blog
const allPosts = await getCollection('blog');

// Filtrage éventuel par catégorie et tri antichronologique (du plus récent au plus vieux)
const filteredPosts = allPosts
  .filter((post) => (category ? post.data.category === category : true))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3); // Limite stricte aux 3 derniers articles
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {filteredPosts.length === 0 ? (
    <p class="col-span-full text-slate-500 text-center py-6">
      Aucun article disponible dans cette section pour le moment.
    </p>
  ) : (
    filteredPosts.map((post) => (
      <article class="flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
        {/* Image optimisée via le composant natif Astro Image */}
        <div class="aspect-video w-full overflow-hidden bg-slate-100">
          <Image
            src={post.data.coverImage}
            alt={post.data.title}
            width={600}
            height={338}
            format="webp"
            class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
            loading="lazy"
          />
        </div>

        <div class="flex flex-1 flex-col justify-between p-5">
          <div>
            <span class="inline-block rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
              {post.data.category}
            </span>
            <h3 class="mt-2 text-lg font-bold text-slate-900 line-clamp-2">
              <a href={`/blog/${post.slug}`} class="hover:text-emerald-600">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-slate-600 line-clamp-3">
              {post.data.description}
            </p>
          </div>

          <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <a href={`/blog/${post.slug}`} class="font-medium text-emerald-600 hover:underline">
              Lire la suite →
            </a>
          </div>
        </div>
      </article>
    ))
  )}
</div>
