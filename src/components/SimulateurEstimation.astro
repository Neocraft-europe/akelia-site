---
// =========================================================================
// COMPOSANT : FORMULAIRE DE CONTACT DU SIMULATEUR
// (src/components/SimulateurEstimation.astro)
// -------------------------------------------------------------------------
// 3e panneau du bloc du simulateur (voir SimulateurQuestions.astro) : il
// REMPLACE le résultat quand on clique sur « Obtenir vos aides réelles ».
// Le lien « Revenir à mes résultats » ramène au résultat.
// Envoi : src/scripts/simulateur-estimation.ts (Web3Forms, comme /devis).
//
// Données envoyées : prénom, e-mail, téléphone. Rien d'autre : les réponses
// au simulateur ne sont pas jointes.
//
// ⚠️ CLÉ WEB3FORMS : la valeur ci-dessous est la même valeur d'exemple que
// sur la page /devis (« YOUR_ACCESS_KEY_HERE »). Tant qu'elle n'est pas
// remplacée par la vraie clé du compte Web3Forms d'Akelia, l'envoi échoue
// et le message d'erreur s'affiche.
// =========================================================================

const cleWeb3Forms = 'YOUR_ACCESS_KEY_HERE';

// Champs du formulaire : grands (56px), filet gris foncé de 1px (texte-doux,
// 7:1 : le champ reste bien repérable) ; 2px rouges en cas d'erreur.
const classesChamp =
  'mt-2 block min-h-14 w-full rounded-bloc border border-texte-doux bg-fond px-4 text-corps text-texte focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900 aria-invalid:border-2 aria-invalid:border-alerte-700';
const classesEtiquette = 'block text-corps font-semibold text-texte';
// Message d'erreur d'un champ : rouge foncé, gras ; vide, il ne prend pas de place.
const classesErreurChamp = 'mt-1 text-corps font-semibold text-alerte-700 empty:mt-0';
---

{/* 3e panneau du bloc : affiché seulement avec data-actif (sinon retiré de
    la mise en page), en fondu à l'apparition. */}
<section
  data-panneau="contact"
  data-estimation
  aria-labelledby="estimation-titre"
  class="min-w-0 hidden data-actif:block transition-[opacity,translate] duration-300 ease-out starting:translate-y-2 starting:opacity-0 motion-reduce:transition-none"
>
  {/* RETOUR AU RÉSULTAT */}
  <button
    type="button"
    data-estimation-revenir
    class="inline-flex min-h-11 items-center gap-2 rounded-bloc px-1 font-semibold text-nuit-900 underline underline-offset-4 hover:bg-creme focus-visible:outline-2 focus-visible:outline-nuit-900"
  >
    <span aria-hidden="true">←</span> Revenir à mes résultats
  </button>

  {/* Le titre reçoit le focus à l'ouverture du panneau (tabindex="-1"). */}
  <h3 id="estimation-titre" tabindex="-1" class="mt-4 text-h3 text-texte focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nuit-900">
    Obtenir une estimation précise de vos aides
  </h3>
  <p class="mt-3 text-corps text-texte">
    Un artisan du collectif étudie votre situation et vous indique les montants exacts auxquels vous avez droit.
  </p>

  {/* Formulaire Web3Forms. novalidate : les erreurs sont affichées en
      toutes lettres sous chaque champ par le script. */}
  <form data-estimation-formulaire novalidate class="mt-6">
    {/* Champs techniques Web3Forms (identiques à /devis, sauf le sujet) */}
    <input type="hidden" name="access_key" value={cleWeb3Forms} />
    <input type="hidden" name="subject" value="Demande d'estimation des aides (simulateur Akelia)" />
    <input type="hidden" name="from_name" value="Akelia Simulateur" />
    {/* Piège à robots : case invisible que seuls les robots cochent */}
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div>
      <label for="estimation-prenom" class={classesEtiquette}>Prénom</label>
      <input id="estimation-prenom" name="prenom" type="text" autocomplete="given-name" aria-describedby="estimation-erreur-prenom" class={classesChamp} />
      <p id="estimation-erreur-prenom" role="alert" class={classesErreurChamp}></p>
    </div>
    <div class="mt-4">
      <label for="estimation-email" class={classesEtiquette}>E-mail</label>
      <input id="estimation-email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="estimation-erreur-email" class={classesChamp} />
      <p id="estimation-erreur-email" role="alert" class={classesErreurChamp}></p>
    </div>
    <div class="mt-4">
      <label for="estimation-telephone" class={classesEtiquette}>Téléphone</label>
      <input id="estimation-telephone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="estimation-erreur-telephone" class={classesChamp} />
      <p id="estimation-erreur-telephone" role="alert" class={classesErreurChamp}></p>
    </div>

    {/* Bouton orange, texte noir : l'action principale. */}
    <button
      type="submit"
      class="mt-6 flex min-h-14 w-full items-center justify-center rounded-bloc bg-action-500 px-8 text-h4 font-semibold text-texte shadow-legere hover:bg-action-600 disabled:cursor-wait disabled:opacity-80 focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-nuit-900"
    >
      Recevoir mon estimation
    </button>

    {/* Message de confirmation ou d'erreur (rempli par le script).
        role="status" : annoncé par les lecteurs d'écran. */}
    <p data-estimation-retour role="status" tabindex="-1" hidden class="mt-4"></p>
  </form>

  {/* MENTION OBLIGATOIRE : sous le formulaire, en texte courant (1.125rem),
      jamais en petits caractères. */}
  <p class="mt-6 border-t border-creme-fonce pt-4 text-corps text-texte">
    Vos coordonnées servent uniquement à vous recontacter au sujet de votre projet. Elles ne sont ni revendues ni utilisées à d'autres fins. Vous pouvez demander leur suppression à tout moment.
  </p>
</section>
