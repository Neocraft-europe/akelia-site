---
// =========================================================================
// COMPOSANT : SUBSTITUT D'ICÔNE (src/components/solutions/Illustration.astro)
// -------------------------------------------------------------------------
// 20 octobre 2026 (refonte des pages solutions), réduit le 21 octobre 2026.
// SUBSTITUT NEUTRE d'une icône de « Est-ce adapté à votre bien ? » quand la
// condition n'a pas de champ `icone` : cercle crème, contour pointillé,
// pictogramme d'image, à la taille de l'icône (la mise en page ne bouge
// pas le jour où l'icône arrive). Toujours décoratif (aria-hidden).
// Historique : il affichait aussi une image fournie par nom de fichier ;
// cette convention est abandonnée (icônes SVG, src/components/
// icones-solutions/) et la branche supprimée à la relecture de code du
// 21 octobre 2026, avec l'attribut data-substitut-illustration (aucun
// script ni style ne le lisait).
// =========================================================================

export interface Props {
  /** Côté en pixels (carré). */
  taille: number;
  class?: string;
}

const { taille, class: classes } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={['flex shrink-0 items-center justify-center rounded-full border-2 border-dashed border-creme-fonce bg-creme text-texte-doux/50', classes]}
  style={`width: ${taille}px; height: ${taille}px`}
>
  <svg class="size-1/3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2" /><path d="m21 16-5-5-9 9" />
  </svg>
</span>
