---
// =========================================================================
// COMPOSANT : AVERTISSEMENT SUR L'ÉCHELLE DES NOTES
// (src/components/solutions/EchelleAkelia.astro)
// -------------------------------------------------------------------------
// Phrase placée sous le bloc « Ses performances » des pages /solutions/…
// IDENTIQUE sur toutes les pages (ticket du 19 octobre 2026) : elle ne
// s'écrit qu'ici. Les notes (A à G, x / 5) ne doivent pas être prises pour
// une étiquette énergie ou un DPE.
// =========================================================================

export interface Props {
  class?: string;
}

const { class: classes } = Astro.props;
---

<p class:list={['flex gap-3 text-corps text-texte-doux', classes]}>
  <svg class="mt-1 size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.5" />
  </svg>
  <span class="min-w-0">Ces notes sont une échelle Akelia, établie pour comparer les solutions entre elles. Elles ne correspondent pas à une classification officielle.</span>
</p>
