---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog & Conseils Rénovation Énergétique | Akelia"
  description="Guides, aides financières (MaPrimeRénov', CEE) et conseils techniques pour réussir votre transition énergétique."
>
  <div class="bg-slate-50 py-12 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">Nos guides & conseils</h1>
        <p class="mt-4 text-lg text-slate-600">
          Retrouvez nos analyses détaillées sur les pompes à chaleur, l'isolation, les panneaux solaires et le financement de vos travaux.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition">
            {/* Image de couverture optimisée par Astro (WebP, dimensions fixes) */}
            <Image
              src={post.data.coverImage}
              alt={post.data.title}
              width={600}
              height={338}
              format="webp"
              class="h-48 w-full object-cover"
              loading="lazy"
            />
            <div class="flex flex-1 flex-col justify-between p-6">
              <div class="flex-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">
                  {post.data.category || 'Conseils'}
                </p>
                <a href={`/blog/${post.id}`} class="mt-2 block">
                  <h2 class="text-xl font-bold text-slate-900 hover:text-emerald-600 transition">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-sm text-slate-600 line-clamp-3">
                    {post.data.description}
                  </p>
                </a>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('fr-FR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <a href={`/blog/${post.id}`} class="font-semibold text-emerald-600 hover:text-emerald-700">
                  Lire l'article &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
