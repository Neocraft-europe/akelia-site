---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} | Blog Akelia`}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <article class="py-12 md:py-20 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <header class="mb-10 text-center">
        <a href="/blog" class="inline-flex items-center text-sm font-semibold text-emerald-600 hover:text-emerald-700 mb-6">
          &larr; Retour aux articles
        </a>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-4 flex items-center justify-center gap-4 text-sm text-slate-500">
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          {post.data.category && (
            <span>•</span>
            <span class="font-medium text-emerald-600">{post.data.category}</span>
          )}
        </div>
      </header>

      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-80 object-cover rounded-2xl mb-10 shadow-sm"
        />
      )}

      <div class="prose prose-slate max-w-none prose-headings:font-bold prose-a:text-emerald-600 hover:prose-a:text-emerald-700">
        <Content />
      </div>
    </div>
  </article>
</Layout>
