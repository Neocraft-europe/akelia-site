---
// =========================================================================
// PAGE D'ACCUEIL (src/pages/index.astro)
// Objectif : Vitrine principale ultra-rapide avec maillage interne vers les services et articles
// =========================================================================

import Layout from '../layouts/Layout.astro';
import AnimationScenes from '../components/AnimationScenes.astro';
import Hero from '../components/Hero.astro';
import CommentCaMarche from '../components/CommentCaMarche.astro';
import Methode from '../components/Methode.astro';
import CasTypes from '../components/CasTypes.astro';
import SimulateurAides from '../components/SimulateurAides.astro';
import Collectif from '../components/Collectif.astro';
import ArticleList from '../components/ArticleList.astro';

// DONNÉES STRUCTURÉES schema.org (16 octobre 2026) : LocalBusiness, lu par
// les moteurs de recherche (fiche d'entreprise). additionalType précise
// l'activité (HomeAndConstructionBusiness : entreprise du bâtiment).
// ⚠️ EN ATTENTE : téléphone (telephone) et adresse (address), à ajouter
// dès qu'ils seront fournis (voir inventaire-charte.md). Sans adresse,
// Google n'affiche pas de fiche enrichie. Logo provisoire : le favicon
// en 180 × 180 (apple-touch-icon.png), faute de logo Akelia.
const site = Astro.site ?? new URL('https://akelia.fr');
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  additionalType: 'https://schema.org/HomeAndConstructionBusiness',
  '@id': new URL('/#entreprise', site).href,
  name: 'Akelia',
  description: "Collectif d'artisans locaux de la rénovation énergétique : isolation, chauffage, solaire. Estimation des aides en ligne et montage du dossier.",
  knowsAbout: 'Rénovation énergétique',
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  image: new URL('/apple-touch-icon.png', site).href,
  sameAs: ['https://www.youtube.com/@Akelia-NC'],
};
---

<Layout
  title="Rénovation énergétique : artisans locaux et aides | Akelia"
  description="Rénovation énergétique avec l'artisan Akelia le plus proche : isolation, chauffage, solaire. Estimez vos aides en ligne, on monte le dossier pour vous."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />

  {/* UNE COULEUR PLEINE LARGEUR PAR SECTION (refonte « alan.com »,
      octobre 2026) : deux sections voisines n'ont jamais la même.
      Couleurs : voir global.css.
        1. Hero (message, schéma et 9 raccourcis) : blanc (crème jusqu'en
           octobre 2026)
        2. « Fonctionnement » (4 étapes, 2 illustrations) : brume, depuis
           le 14 octobre 2026 (argile, refusée, le premier jour). Il
           remplace le bandeau des 8 solutions, dont les raccourcis sont
           passés dans le Hero.
        3. Méthode (4 étapes) : blanc
        4. « Deux façons de faire » : crème foncé (creme-fonce)
        5. Cas types : une couleur par onglet (--color-cas-…), bleu nuit
           profond pour le premier, « Bâti ancien » (violet, puis prune,
           avant)
        6. Simulateur d'aides : blanc (lichen, puis lagon, jusqu'au
           15 octobre 2026)
        7. Collectif : bleu nuit
        8. Articles : blanc depuis le 16 octobre 2026 (bruyère avant),
           cartes blanches détachées par un filet crème foncé
      Pied de page : crème.
      Sur les fonds teintés, les blocs intérieurs sont blancs. */}

  {/* Animation d'entrée des sections (data-scene), avant tout le reste */}
  <AnimationScenes />

  {/* Section d'ouverture : surtitre, titre, sous-titre, bouton devis, schéma et raccourcis vers les solutions */}
  <Hero />

  {/* Section 1 bis : « Fonctionnement », 4 étapes et 2 illustrations. Fond brume. */}
  <CommentCaMarche />

  {/* Section 2 : la méthode en 4 étapes, puis les deux façons de travailler avec nous */}
  <Methode />

  {/* Section 3 : les 5 cas types, en onglets (un seul panneau affiché à la fois) */}
  <CasTypes />

  {/* Section 4 : simulateur d'éligibilité aux aides (3 questions, résultat immédiat, aucune donnée envoyée) */}
  <SimulateurAides />

  {/* Section 5 : le collectif (réseau national d'artisans locaux) et ses 5 engagements. Fond bleu nuit. */}
  <Collectif />

  {/* Section 6 : derniers articles du blog. Fond blanc (bruyère jusqu'au 16 octobre 2026), cartes blanches à filet crème foncé. */}
  <section data-scene aria-labelledby="articles-titre" class="bg-fond">
    <div class="mx-auto max-w-site px-gouttiere py-scene md:py-scene-large">
      <div class="mb-bloc flex flex-wrap items-end justify-between gap-4">
        <div data-scene-titre>
          <p class="surtitre">Le blog</p>
          <h2 id="articles-titre" class="mt-3 text-h2 text-texte">Actualités et conseils</h2>
          <p class="mt-4 text-corps text-texte-doux">Nos derniers guides pour réduire votre consommation d'énergie.</p>
        </div>
        <a href="/blog" class="inline-flex min-h-11 items-center font-semibold text-vert-600 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900">
          Tous les articles <span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>
      <ArticleList />
    </div>
  </section>
</Layout>
