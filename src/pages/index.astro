---
// =========================================================================
// PAGE D'ACCUEIL (src/pages/index.astro)
// Objectif : Vitrine principale ultra-rapide avec maillage interne vers les services et articles
// =========================================================================

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Methode from '../components/Methode.astro';
import SimulateurAides from '../components/SimulateurAides.astro';
import Collectif from '../components/Collectif.astro';
import ArticleList from '../components/ArticleList.astro';
---

<Layout
  title="Akelia - Expert Rénovation Énergétique & Solutions Durables"
  description="Accélérez votre transition écologique avec Akelia. Pompes à chaleur, isolation, panneaux solaires et bornes de recharge pour particuliers et professionnels."
>
  {/* Section d'ouverture : titre, sous-titre, bouton devis et raccourcis vers les solutions */}
  <Hero />

  {/* Section 2 : la méthode en 4 étapes, puis les deux façons de travailler avec nous */}
  <Methode />

  {/* Section 4 : simulateur d'éligibilité aux aides (3 questions, résultat immédiat, aucune donnée envoyée) */}
  <SimulateurAides />

  {/* Section 5 : le collectif (réseau national d'artisans locaux) et ses 5 engagements. Fond blanc. */}
  <Collectif />

  {/* Derniers articles du blog */}
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Actualités & Conseils</h2>
          <p class="mt-1 text-sm text-slate-500">Nos derniers guides pour réduire votre empreinte énergétique.</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-emerald-600 hover:underline">
          Tous les articles →
        </a>
      </div>
      <ArticleList />
    </div>
  </section>
</Layout>
