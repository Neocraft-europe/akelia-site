---
// =========================================================================
// PAGE CATALOGUE SERVICES (src/pages/services/index.astro)
// Objectif : Répertoire sémantique des 5 domaines d'expertise Akelia
// =========================================================================

import Layout from '../../layouts/Layout.astro';

const services = [
  {
    id: 'chauffage',
    title: 'Systèmes de Chauffage',
    desc: 'Pompes à chaleur air/eau, air/air et chaudières biomasse à haut rendement.',
  },
  {
    id: 'chauffe-eau',
    title: 'Chauffe-eau Écologique',
    desc: 'Ballons thermodynamiques et solutions solaires thermiques.',
  },
  {
    id: 'electricite',
    title: 'Production d’Électricité',
    desc: 'Panneaux solaires photovoltaïques en autoconsommation et revente de surplus.',
  },
  {
    id: 'renovation',
    title: 'Rénovation Énergétique Globale',
    desc: 'Isolation thermique par l’extérieur (ITE), combles et menuiseries performantes.',
  },
  {
    id: 'bornes',
    title: 'Voitures Électriques',
    desc: 'Installation sécurisée de bornes de recharge ultra-rapides à domicile.',
  },
];
---

<Layout
  title="Nos Services de Rénovation Énergétique | Akelia"
  description="Découvrez l'ensemble des solutions Akelia : pompes à chaleur, chauffe-eau thermodynamique, panneaux photovoltaïques et bornes pour véhicules électriques."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-texte sm:text-4xl">Nos Services</h1>
      <p class="mt-3 text-lg text-texte-doux">
        Des solutions techniques fiables et garanties pour optimiser le confort et le rendement de votre habitat.
      </p>
    </header>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <section id={service.id} class="rounded-bloc border border-creme-fonce p-6 bg-fond shadow-sm flex flex-col justify-between">
          <div>
            <h2 class="text-xl font-bold text-texte">{service.title}</h2>
            <p class="mt-2 text-texte-doux">{service.desc}</p>
          </div>
          <div class="mt-6">
            <a
              href="/devis"
              class="inline-block rounded-bloc bg-vert-50 px-3 py-2 text-sm font-semibold text-vert-600 hover:bg-creme-fonce"
            >
              Demander un devis pour ce service →
            </a>
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
