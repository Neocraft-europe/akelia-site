---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Demande de devis gratuit | Akelia Rénovation Énergétique"
  description="Obtenez un devis gratuit et personnalisé pour vos travaux de rénovation énergétique : pompe à chaleur, isolation, panneaux solaires."
>
  <div class="bg-creme py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-texte sm:text-4xl">Demandez votre devis gratuit</h1>
        <p class="mt-4 text-lg text-texte-doux">
          Remplissez le formulaire ci-dessous. Nos experts vous recontactent sous 24 à 48 heures pour étudier votre projet et vos aides financières.
        </p>
      </div>

      <div class="bg-fond rounded-bloc shadow-sm border border-creme-fonce p-6 sm:p-10">
        <form id="quote-form" class="space-y-6">
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
          <input type="hidden" name="subject" value="Nouvelle demande de devis sur Akelia" />
          <input type="hidden" name="from_name" value="Akelia Contact" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label for="name" class="block text-sm font-semibold text-texte">Nom complet *</label>
            <input
              type="text"
              name="name"
              id="name"
              required
              class="mt-1 block w-full rounded-bloc border border-texte-doux px-4 py-3 text-texte placeholder-texte-doux focus:border-nuit-900 focus:ring-nuit-900 focus:outline-none"
              placeholder="Ex: Jean Dupont"
            />
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <label for="email" class="block text-sm font-semibold text-texte">Adresse email *</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="mt-1 block w-full rounded-bloc border border-texte-doux px-4 py-3 text-texte placeholder-texte-doux focus:border-nuit-900 focus:ring-nuit-900 focus:outline-none"
                placeholder="jean.dupont@example.com"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-texte">Numéro de téléphone *</label>
              <input
                type="tel"
                name="phone"
                id="phone"
                required
                class="mt-1 block w-full rounded-bloc border border-texte-doux px-4 py-3 text-texte placeholder-texte-doux focus:border-nuit-900 focus:ring-nuit-900 focus:outline-none"
                placeholder="06 12 34 56 78"
              />
            </div>
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-texte">Type de travaux envisagés *</label>
            <select
              id="service"
              name="service"
              required
              class="mt-1 block w-full rounded-bloc border border-texte-doux px-4 py-3 text-texte focus:border-nuit-900 focus:ring-nuit-900 focus:outline-none"
            >
              <option value="">Sélectionnez un projet</option>
              <option value="Pompe à chaleur (PAC)">Pompe à chaleur (PAC)</option>
              <option value="Isolation thermique (murs, combles)">Isolation thermique</option>
              <option value="Panneaux solaires photovoltaïques">Panneaux solaires photovoltaïques</option>
              <option value="Rénovation globale">Rénovation énergétique globale</option>
              <option value="Autre demande">Autre projet</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-texte">Détails de votre projet</label>
            <textarea
              name="message"
              id="message"
              rows="4"
              class="mt-1 block w-full rounded-bloc border border-texte-doux px-4 py-3 text-texte placeholder-texte-doux focus:border-nuit-900 focus:ring-nuit-900 focus:outline-none"
              placeholder="Indiquez l'année de construction du logement, la surface, le mode de chauffage actuel..."
            ></textarea>
          </div>

          <div id="form-feedback" class="hidden rounded-bloc p-4 text-sm font-semibold"></div>

          <div>
            <button
              type="submit"
              id="submit-btn"
              class="w-full inline-flex justify-center items-center rounded-bloc bg-vert-600 px-6 py-3.5 text-base font-semibold text-texte-inverse shadow-sm hover:bg-nuit-700 focus:outline-none focus:ring-2 focus:ring-nuit-900 focus:ring-offset-2 transition"
            >
              Envoyer ma demande
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('quote-form');
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn');

    if (form && feedback && submitBtn) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const initialBtnText = submitBtn.textContent;
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Envoi en cours...';
        feedback.className = 'hidden';

        const formData = new FormData(form as HTMLFormElement);

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (response.ok && result.success) {
            feedback.className = 'rounded-bloc p-4 text-sm font-semibold bg-vert-50 text-vert-600 border border-vert-400';
            feedback.textContent = 'Merci ! Votre demande a bien été envoyée. Nos experts reviendront vers vous très vite.';
            (form as HTMLFormElement).reset();
          } else {
            feedback.className = 'rounded-bloc p-4 text-sm font-semibold bg-rose-50 text-rose-800 border border-rose-200';
            feedback.textContent = result.message || "Une erreur est survenue lors de l'envoi du formulaire. Veuillez réessayer.";
          }
        } catch {
          feedback.className = 'rounded-bloc p-4 text-sm font-semibold bg-rose-50 text-rose-800 border border-rose-200';
          feedback.textContent = 'Impossible de joindre le serveur. Veuillez vérifier votre connexion et réessayer.';
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = initialBtnText;
        }
      });
    }
  </script>
</Layout>
