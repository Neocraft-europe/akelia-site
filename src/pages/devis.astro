---
// =========================================================================
// PAGE « DEMANDEZ VOTRE DEVIS GRATUIT » (src/pages/devis.astro)
// -------------------------------------------------------------------------
// Refonte du 17 octobre 2026 (détail dans inventaire-charte.md, section
// « /devis : refonte de la page »).
//
// DISPOSITION :
// - à partir de 1024px (lg:) : deux colonnes, formulaire à gauche (60 %),
//   colonne de réassurance à droite (40 %) ;
// - en dessous : formulaire d'abord, réassurance ensuite (ordre du code).
//
// FORMULAIRE : envoi Web3Forms (clé : src/data/web3forms.ts). Les noms de
// champs (attribut name) sont en français : Web3Forms les reprend tels
// quels dans le corps de l'e-mail (« Nom : … », « Code postal : … »).
// - Avec JavaScript : vérification par le script, messages d'erreur en
//   toutes lettres sous chaque champ (comme le simulateur), envoi en
//   arrière-plan, confirmation qui REMPLACE le formulaire.
// - Sans JavaScript : le navigateur vérifie les champs obligatoires
//   (required, pattern), puis le formulaire est posté directement à
//   Web3Forms, qui affiche sa propre page de confirmation.
//
// CONSIGNE DU CHAMP « PRÉCISIONS » : elle change selon les cases cochées
// (tableau `consignes` ci-dessous, lu par le script). Sans JavaScript, la
// consigne générique reste affichée.
//
// ILLUSTRATION : devis.png, dans src/assets/illustrations/. Tant que le
// fichier manque, rien n'est affiché (pas d'emplacement vide).
// =========================================================================

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import NoteMinimale from '../components/NoteMinimale.astro';
import { noteEnTexte } from '../data/collectif';
import { CLE_WEB3FORMS, ADRESSE_WEB3FORMS } from '../data/web3forms';
import { illustration, zoneDessinee, styleCadre, styleRecadrage } from '../data/illustrations';

// Choix du type de projet : plusieurs choix possibles (cases à cocher).
// RÈGLE D'EXCLUSIVITÉ (17 octobre 2026, appliquée par le script) : soit un
// projet d'ensemble, soit un ou plusieurs équipements, jamais les deux.
// - Rénovation globale et Construction neuve s'excluent l'une l'autre, et
//   cocher l'une décoche tous les équipements ;
// - cocher un équipement décoche les deux projets d'ensemble ;
// - les équipements se cumulent entre eux ;
// - « Je ne sais pas encore » décoche tout le reste, et inversement.
// Sans JavaScript, les cases restent librement cochables.
// La valeur envoyée est le libellé affiché : c'est elle qui figure dans
// l'e-mail (champ « Type de projet ») et dans le sujet.
// `groupe` : la famille de consigne du champ « Précisions » (voir
// `consignes`) ; sans groupe, consigne générique.
const projetsPrincipaux = [
  { libelle: 'Rénovation globale', groupe: 'global' },
  { libelle: 'Construction neuve', groupe: 'global' },
];
const services = [
  { libelle: 'Isolation', groupe: 'enveloppe' },
  { libelle: 'Pompe à chaleur', groupe: 'chauffage' },
  { libelle: 'Panneaux photovoltaïques', groupe: 'solaire' },
  { libelle: 'Fenêtres et volets', groupe: 'enveloppe' },
  { libelle: 'Chauffe-eau', groupe: 'chauffage' },
  { libelle: 'Borne de recharge', groupe: 'borne' },
  { libelle: 'Climatisation réversible', groupe: 'chauffage' },
  // « Je ne sais pas encore » est exclusif de tout (voir la règle
  // d'exclusivité ci-dessous).
  { libelle: 'Je ne sais pas encore', groupe: '', exclusif: true },
  { libelle: 'Autre projet', groupe: '' },
];

// Consignes du champ « Précisions » (textes fournis le 17 octobre 2026).
// Si toutes les cases cochées appartiennent au même groupe, sa consigne
// s'affiche ; sinon (groupes différents, ou rien de coché), la générique.
const consigneGenerique = 'Décrivez votre projet en quelques mots.';
const consignes: Record<string, string> = {
  global: 'Année de construction, surface, mode de chauffage actuel, travaux déjà réalisés…',
  enveloppe: 'Surface concernée, type de murs, isolation déjà en place…',
  chauffage: 'Surface à chauffer, mode de chauffage actuel, nombre de pièces…',
  solaire: 'Orientation et surface du toit, consommation annuelle…',
  borne: 'Type de véhicule, emplacement souhaité, distance au tableau électrique…',
};

const statuts = ['Propriétaire occupant', 'Propriétaire bailleur', 'Locataire'];

// Étapes de la colonne de réassurance (textes fournis le 17 octobre 2026).
const etapes = [
  "Votre demande arrive directement chez l'artisan Akelia le plus proche de chez vous. Vos coordonnées ne sortent jamais du réseau : ni revente, ni mise en concurrence.",
  'Il vous rappelle sous 24 à 48 heures pour comprendre votre projet.',
  'Il se déplace chez vous gratuitement et vous remet un devis détaillé : nature des travaux, aides estimées, reste à charge.',
];

const imageDevis = illustration('devis.png');
const zoneDevis = await zoneDessinee('devis.png');

// --- Classes communes -----------------------------------------------------
// Case de choix entièrement cliquable (56px de haut). Cochée : cadre et
// fond verts, comme les choix du simulateur. Le second filet (ring)
// épaissit le cadre à 2px sans décaler la mise en page.
const classesChoix =
  'flex min-h-14 cursor-pointer items-center gap-3 rounded-bloc px-4 text-corps text-texte hover:border-vert-600 has-checked:border-vert-600 has-checked:bg-vert-50 has-checked:font-semibold has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-nuit-900';
const classesService = `${classesChoix} border border-texte-doux bg-fond has-checked:ring-1 has-checked:ring-vert-600`;
const classesPrincipal = `${classesChoix} border-2 border-nuit-900 bg-action-50 font-semibold`;
const classesPastille = 'size-6 shrink-0 accent-vert-600';
// Champs : mêmes réglages que le formulaire du simulateur (56px, filet
// texte-doux, 2px rouge foncé en cas d'erreur).
const classesChamp =
  'mt-2 block min-h-14 w-full rounded-bloc border border-texte-doux bg-fond px-4 text-corps text-texte focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900 aria-invalid:border-2 aria-invalid:border-alerte-700';
const classesEtiquette = 'block text-corps font-semibold text-texte';
const classesFacultatif = 'font-normal text-texte-doux';
// Message d'erreur d'un champ : vide, il ne prend pas de place.
const classesErreur = 'mt-1 text-corps font-semibold text-alerte-700 empty:mt-0';
---

<Layout
  title="Demande de devis gratuit | Akelia Rénovation Énergétique"
  description="Obtenez un devis gratuit et personnalisé pour vos travaux de rénovation énergétique : pompe à chaleur, isolation, panneaux solaires."
>
  <div class="bg-creme">
    <div class="mx-auto max-w-site px-gouttiere py-scene md:py-scene-large">
      {/* EN-TÊTE DE LA PAGE */}
      <h1 class="text-h2 text-balance text-texte md:text-h1 md:font-black">Demandez votre devis gratuit</h1>
      <p class="mt-4 text-chapeau text-texte">Un artisan du collectif vous rappelle sous 24 à 48 heures.</p>

      {/* DEUX COLONNES (60 / 40) à partir de 1024px */}
      <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-14">

        {/* ===== COLONNE GAUCHE : FORMULAIRE ===== */}
        <div class="min-w-0 self-start rounded-bloc border border-creme-fonce bg-fond p-5 shadow-legere sm:p-10">
          {/* Le formulaire. Sans JavaScript : vérification par le navigateur
              puis envoi direct à Web3Forms (action). Le script ajoute
              novalidate et prend la main. */}
          <form id="formulaire-devis" action={ADRESSE_WEB3FORMS} method="POST" aria-label="Demande de devis">
            <input type="hidden" name="access_key" value={CLE_WEB3FORMS} />
            <input type="hidden" name="subject" value="Nouvelle demande de devis sur Akelia" />
            <input type="hidden" name="from_name" value="Akelia Devis" />
            {/* Piège à robots : case invisible que seuls les robots cochent */}
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

            {/* 1. TYPE DE PROJET : grandes cases à cocher */}
            <fieldset aria-describedby="aide-projet erreur-projet">
              <legend class={classesEtiquette}>Type de projet</legend>
              <p id="aide-projet" class="mt-1 text-corps text-texte-doux">Plusieurs choix possibles.</p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {projetsPrincipaux.map((projet) => (
                  <label class={classesPrincipal}>
                    <input type="checkbox" name="Type de projet" value={projet.libelle} data-groupe={projet.groupe} data-nature="ensemble" class={classesPastille} />
                    {projet.libelle}
                  </label>
                ))}
              </div>
              <p class="mt-5 text-corps text-texte">Ou un équipement en particulier&nbsp;:</p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {services.map((service) => (
                  <label class={classesService}>
                    <input
                      type="checkbox"
                      name="Type de projet"
                      value={service.libelle}
                      data-groupe={service.groupe}
                      data-nature={service.exclusif ? 'exclusif' : 'equipement'}
                      class={classesPastille}
                    />
                    <span class="min-w-0 hyphens-auto">{service.libelle}</span>
                  </label>
                ))}
              </div>
              <p id="erreur-projet" role="alert" class={classesErreur}></p>
            </fieldset>

            {/* 2. PRÉCISIONS : la consigne (sous l'étiquette, pas en
                placeholder) change selon les cases cochées. */}
            <div class="mt-8">
              <label for="devis-precisions" class={classesEtiquette}>
                Précisions sur votre projet <span class={classesFacultatif}>(facultatif)</span>
              </label>
              <p id="consigne-precisions" class="mt-1 text-corps text-texte-doux">{consigneGenerique}</p>
              <textarea
                id="devis-precisions"
                name="Précisions"
                rows="4"
                aria-describedby="consigne-precisions"
                class={`${classesChamp} py-3`}
              ></textarea>
            </div>

            {/* 3 à 7. COORDONNÉES */}
            <div class="mt-8">
              <label for="devis-nom" class={classesEtiquette}>Nom</label>
              <input id="devis-nom" name="Nom" type="text" autocomplete="name" required aria-describedby="erreur-nom" class={classesChamp} />
              <p id="erreur-nom" role="alert" class={classesErreur}></p>
            </div>

            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div>
                <label for="devis-telephone" class={classesEtiquette}>Téléphone</label>
                <input id="devis-telephone" name="Téléphone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="erreur-telephone" class={classesChamp} />
                <p id="erreur-telephone" role="alert" class={classesErreur}></p>
              </div>
              <div>
                <label for="devis-code-postal" class={classesEtiquette}>Code postal</label>
                <input
                  id="devis-code-postal"
                  name="Code postal"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  maxlength="5"
                  pattern="[0-9]{5}"
                  required
                  aria-describedby="erreur-code-postal"
                  class={classesChamp}
                />
                <p id="erreur-code-postal" role="alert" class={classesErreur}></p>
              </div>
            </div>

            <div class="mt-6">
              <label for="devis-adresse" class={classesEtiquette}>
                Adresse <span class={classesFacultatif}>(facultatif)</span>
              </label>
              <input id="devis-adresse" name="Adresse" type="text" autocomplete="street-address" class={classesChamp} />
            </div>

            <div class="mt-6">
              <label for="devis-email" class={classesEtiquette}>
                E-mail <span class={classesFacultatif}>(facultatif)</span>
              </label>
              <input id="devis-email" name="E-mail" type="email" autocomplete="email" inputmode="email" aria-describedby="erreur-email" class={classesChamp} />
              <p id="erreur-email" role="alert" class={classesErreur}></p>
            </div>

            {/* 8. STATUT (facultatif, un seul choix) */}
            <fieldset class="mt-8">
              <legend class={classesEtiquette}>
                Vous êtes <span class={classesFacultatif}>(facultatif)</span>
              </legend>
              <div class="mt-3 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
                {statuts.map((statut) => (
                  <label class={classesService}>
                    <input type="radio" name="Vous êtes" value={statut} class={classesPastille} />
                    <span class="min-w-0">{statut}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            {/* Message d'échec de l'envoi (rempli par le script) */}
            <p id="devis-echec" role="alert" tabindex="-1" hidden class="mt-8 rounded-bloc border-2 border-alerte-700 bg-alerte-50 p-4 text-corps font-semibold text-texte"></p>

            {/* Bouton orange, texte noir : l'action principale du site. */}
            <button
              type="submit"
              class="mt-8 flex min-h-14 w-full items-center justify-center rounded-bloc bg-action-500 px-8 text-h4 font-semibold text-texte shadow-legere hover:bg-action-600 disabled:cursor-wait disabled:opacity-80 focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-nuit-900"
            >
              Envoyer ma demande
            </button>

            {/* MENTION SUR LES DONNÉES : texte courant, jamais en petits
                caractères. ⚠️ /politique-confidentialite n'existe pas encore. */}
            <p class="mt-6 border-t border-creme-fonce pt-4 text-corps text-texte">
              Vos coordonnées servent uniquement à vous recontacter au sujet de votre projet. Elles ne sont ni revendues ni utilisées à d'autres fins. Vous pouvez demander leur suppression à tout moment.
              Pour en savoir plus, consultez notre <a href="/politique-confidentialite" class="font-semibold text-nuit-900 underline underline-offset-4 hover:text-vert-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900">politique de confidentialité</a>.
            </p>
          </form>

          {/* CONFIRMATION : remplace le formulaire après l'envoi réussi.
              Le focus y est placé (tabindex="-1") pour les lecteurs
              d'écran. */}
          <div id="devis-confirmation" tabindex="-1" hidden class="py-6 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nuit-900">
            <span aria-hidden="true" class="flex size-14 items-center justify-center rounded-pilule border-2 border-succes-600 bg-succes-50 text-h3 text-succes-600">✓</span>
            <h2 class="mt-6 text-h3 text-texte">Merci, votre demande est partie.</h2>
            <p class="mt-4 text-corps text-texte">L'artisan Akelia le plus proche de chez vous vous rappelle sous 24 à 48 heures.</p>
          </div>
        </div>

        {/* ===== COLONNE DROITE : RÉASSURANCE ===== */}
        <aside aria-labelledby="ensuite-titre" class="min-w-0">
          <h2 id="ensuite-titre" class="text-h3 text-balance text-texte">Ce qui se passe ensuite</h2>

          {/* Étapes numérotées, style de la section « Fonctionnement » :
              pastille blanche cerclée d'orange, filet orange entre les
              pastilles. */}
          <ol class="mt-8">
            {etapes.map((texte, index) => (
              <li class="relative flex gap-5 pb-8 last:pb-0">
                {index < etapes.length - 1 && (
                  <span aria-hidden="true" class="absolute top-12 bottom-2 left-5 w-0.5 -translate-x-1/2 bg-action-500/60"></span>
                )}
                <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-pilule border-2 border-action-500 bg-fond text-h4 font-bold text-marque-900">
                  {index + 1}
                </span>
                <p class="pt-1 text-corps text-nuit-700">
                  <span class="sr-only">Étape {index + 1} : </span>{texte}
                </p>
              </li>
            ))}
          </ol>

          {/* ENCART « SÉLECTION DES ARTISANS » (refait le 17 octobre 2026) :
              l'argument de confiance de la page. Fond bleu nuit plein,
              centré, nettement distinct des étapes.
              - la note minimale (NoteMinimale.astro, valeur lue dans
                src/data/collectif.ts, commune avec /qui-sommes-nous) ;
              - ⚠️ « note minimale exigée » est OBLIGATOIRE et doit rester
                lisible (16px, semi-gras, blanc) : sans elle, la note serait
                prise pour une moyenne d'avis clients (pratique commerciale
                trompeuse).
              Ordre du code : la note puis « note minimale exigée » (lu
              ainsi par les lecteurs d'écran) ; flex-row-reverse remet les
              étoiles à gauche à l'écran.
              Contrastes sur nuit-900 : blanc 14,5:1, orange 6,1:1. */}
          <div class="mt-14 rounded-bloc bg-nuit-900 px-6 py-8 text-center text-texte-inverse shadow-legere">
            <h3 class="sr-only">Comment nous choisissons nos artisans</h3>
            <NoteMinimale />
            <p class="mt-6 text-corps text-balance">Nous ne retenons dans le collectif que des entreprises notées {noteEnTexte} ou plus, certifiées RGE et assurées.</p>
          </div>

          {/* ILLUSTRATION (devis.png) : rien n'est affiché si elle manque.
              Recadrée sur la zone dessinée (fond transparent) : l'image
              entière est donc affichée PLUS LARGE que son cadre (2,5 fois
              pour devis.png). `sizes` annonce cette largeur réelle, sinon le
              navigateur charge une variante trop petite et l'étire (cause
              du flou corrigée le 17 octobre 2026).
              Cadre : 14rem (224px) sous 1024px, 18rem (288px) au-delà ; le
              dessin (813px de large dans le fichier) reste net jusqu'à un
              écran 2x (576px utiles) et quasi net en 3x sur téléphone
              (672px utiles). */}
          {imageDevis && zoneDevis && (
            <div class="mx-auto mt-10 w-56 lg:w-72">
              <div class="relative overflow-hidden" style={styleCadre(zoneDevis)}>
                <Image
                  src={imageDevis}
                  alt=""
                  widths={[600, 900, 1200, 1600, 2048].filter((l) => l <= zoneDevis.largeur)}
                  sizes={`(min-width: 1024px) ${Math.ceil((288 * zoneDevis.largeur) / zoneDevis.l)}px, ${Math.ceil((224 * zoneDevis.largeur) / zoneDevis.l)}px`}
                  format="webp"
                  loading="lazy"
                  class="absolute h-auto"
                  style={styleRecadrage(zoneDevis)}
                />
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>

  {/* Consignes du champ « Précisions », transmises au script. */}
  <script is:inline type="application/json" id="donnees-consignes" set:html={JSON.stringify({ generique: consigneGenerique, groupes: consignes })}></script>

  <script>
    import { ADRESSE_WEB3FORMS } from '../data/web3forms';

    const MESSAGES = {
      envoi: 'Envoi en cours…',
      erreur: "Votre demande n'a pas pu être envoyée. Veuillez réessayer dans quelques minutes.",
      injoignable: 'Impossible de joindre le serveur. Veuillez vérifier votre connexion et réessayer.',
      projet: 'Choisissez au moins un type de projet.',
      nom: 'Indiquez votre nom.',
      telephone: 'Indiquez un numéro de téléphone (10 chiffres).',
      codePostal: 'Indiquez un code postal de 5 chiffres, par exemple 31000.',
      email: 'Indiquez une adresse e-mail valide, par exemple jean.dupont@exemple.fr, ou laissez ce champ vide.',
    };
    const PROJET = 'Type de projet';

    const formulaire = document.querySelector<HTMLFormElement>('#formulaire-devis');
    const confirmation = document.getElementById('devis-confirmation');
    const echec = document.getElementById('devis-echec');
    const consigne = document.getElementById('consigne-precisions');
    const donnees = JSON.parse(document.getElementById('donnees-consignes')?.textContent ?? '{}') as {
      generique: string;
      groupes: Record<string, string>;
    };

    if (formulaire && confirmation && echec && consigne) {
      // Le script prend la main sur la vérification du navigateur.
      formulaire.noValidate = true;
      const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const cases = [...formulaire.querySelectorAll<HTMLInputElement>(`input[name="${PROJET}"]`)];

      // --- Consigne adaptée et exclusivité des cases ----------------------
      function majConsigne() {
        const groupes = new Set(cases.filter((c) => c.checked).map((c) => c.dataset.groupe ?? ''));
        const [seul] = groupes;
        consigne!.textContent = groupes.size === 1 && seul && donnees.groupes[seul] ? donnees.groupes[seul] : donnees.generique;
      }
      cases.forEach((caseProjet) => {
        caseProjet.addEventListener('change', () => {
          if (caseProjet.checked) {
            // Seuls deux équipements peuvent rester cochés ensemble : toute
            // autre case cochée décoche les autres (voir l'en-tête).
            const equipement = caseProjet.dataset.nature === 'equipement';
            cases.forEach((autre) => {
              if (autre !== caseProjet && !(equipement && autre.dataset.nature === 'equipement')) autre.checked = false;
            });
          }
          erreur('projet', null);
          majConsigne();
        });
      });
      majConsigne();

      // --- Erreurs par champ ---------------------------------------------
      const champs: Record<string, HTMLInputElement | null> = {
        projet: cases[0] ?? null,
        nom: formulaire.querySelector('#devis-nom'),
        telephone: formulaire.querySelector('#devis-telephone'),
        'code-postal': formulaire.querySelector('#devis-code-postal'),
        email: formulaire.querySelector('#devis-email'),
      };

      /** Affiche ou efface le message d'erreur d'un champ. */
      function erreur(cle: string, message: string | null) {
        const zone = document.getElementById(`erreur-${cle}`);
        if (zone) zone.textContent = message ?? '';
        const cibles = cle === 'projet' ? cases : [champs[cle]];
        cibles.forEach((champ) => {
          if (!champ) return;
          if (message) champ.setAttribute('aria-invalid', 'true');
          else champ.removeAttribute('aria-invalid');
        });
      }

      /** Vérifie les champs ; renvoie le premier champ en erreur, ou null. */
      function verifier(): HTMLInputElement | null {
        const val = (cle: string) => (champs[cle]?.value ?? '').trim();
        const email = val('email');
        const resultats: [string, string | null][] = [
          ['projet', cases.some((c) => c.checked) ? null : MESSAGES.projet],
          ['nom', val('nom') ? null : MESSAGES.nom],
          ['telephone', val('telephone').replace(/\D/g, '').length >= 10 ? null : MESSAGES.telephone],
          ['code-postal', /^\d{5}$/.test(val('code-postal')) ? null : MESSAGES.codePostal],
          ['email', !email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? null : MESSAGES.email],
        ];
        resultats.forEach(([cle, message]) => erreur(cle, message));
        const premiere = resultats.find(([, message]) => message);
        return premiere ? champs[premiere[0]] : null;
      }

      // Effacer l'erreur d'un champ dès qu'on le corrige.
      Object.entries(champs).forEach(([cle, champ]) => {
        if (cle !== 'projet') champ?.addEventListener('input', () => erreur(cle, null));
      });

      /** Contenu envoyé : projets réunis sur une ligne, champs vides retirés. */
      function preparerEnvoi(): FormData {
        const saisie = new FormData(formulaire!);
        const projets = saisie.getAll(PROJET).map(String);
        // Reconstruit dans l'ordre du formulaire, les projets à la place
        // de la première case cochée.
        const ordonne = new FormData();
        for (const [nom, valeur] of saisie) {
          if (nom === PROJET) {
            if (!ordonne.has(PROJET)) ordonne.append(PROJET, projets.join(', '));
            continue;
          }
          if (nom !== 'botcheck' && typeof valeur === 'string' && !valeur.trim()) continue;
          ordonne.append(nom, valeur);
        }
        ordonne.set('subject', `Demande de devis Akelia : ${projets.join(', ')}`);
        // Adresse de réponse de l'e-mail (Web3Forms la lit dans « replyto »).
        const email = String(ordonne.get('E-mail') ?? '');
        if (email) ordonne.append('replyto', email);
        return ordonne;
      }

      formulaire.addEventListener('submit', async (evenement) => {
        evenement.preventDefault();
        echec.hidden = true;

        const champEnErreur = verifier();
        if (champEnErreur) {
          champEnErreur.focus();
          return;
        }

        const texteInitial = bouton.textContent;
        bouton.disabled = true;
        bouton.textContent = MESSAGES.envoi;

        try {
          const reponse = await fetch(ADRESSE_WEB3FORMS, { method: 'POST', body: preparerEnvoi() });
          const resultat = await reponse.json();
          if (reponse.ok && resultat.success) {
            // La confirmation REMPLACE le formulaire.
            formulaire.reset();
            formulaire.hidden = true;
            confirmation.hidden = false;
            confirmation.scrollIntoView({ block: 'center' });
            confirmation.focus({ preventScroll: true });
            return;
          }
          // Message de Web3Forms (en anglais) gardé pour la console seulement.
          console.error('Web3Forms :', resultat.message);
          echec.textContent = MESSAGES.erreur;
        } catch {
          echec.textContent = MESSAGES.injoignable;
        } finally {
          bouton.disabled = false;
          bouton.textContent = texteInitial;
        }
        echec.hidden = false;
        echec.focus();
      });
    }
  </script>
</Layout>
