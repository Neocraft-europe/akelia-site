---
// =========================================================================
// GABARIT D'ARTICLE DE BLOG (src/pages/post/[slug].astro)
// -------------------------------------------------------------------------
// Adresse : /post/<slug>, héritée de Webflow (17 octobre 2026). NE PAS LA
// CHANGER : les articles contiennent des dizaines de liens internes vers
// cette forme d'adresse, et le site est référencé dessus.
// Une page par article de src/content/blog/, brouillons exclus.
//
// TROIS ZONES (refonte du 17 octobre 2026 : la colonne unique de 540px
// paraissait vide sur ordinateur) :
//   ZONE 1, en-tête (56rem, centrée) : fil d'Ariane, catégorie, titre (h1),
//     dates, chapeau, puis la vidéo YouTube s'il y en a une, SINON la
//     couverture ;
//   ZONE 2, corps (72rem) : à partir de 992px (lg), deux colonnes :
//     - à gauche (16rem), un bloc collant : sommaire de l'article (titres
//       h2) et petit appel à l'action ;
//     - à droite (texte plafonné à 70ch, environ 700px) : « En bref »,
//       corps de l'article (classe prose, réglages dans global.css),
//       sources, grand appel à l'action vers /devis.
//     En dessous de 992px : une colonne ; le sommaire, replié dans un
//     <details>, suit « En bref ».
//     Moins de 3 titres h2 (articles vidéo) : ni sommaire ni colonne de
//     gauche, une seule colonne centrée.
//   ZONE 3, articles liés (src/utils/blog.ts), pleine largeur.
//
// SEO : title (titreSeo, sinon titre), description, canonique, Open Graph
// et Twitter avec la couverture optimisée, JSON-LD Article (et
// VideoObject si vidéo) et BreadcrumbList, tous générés ici à partir du
// frontmatter.
// =========================================================================

import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import FilAriane from '../../components/FilAriane.astro';
import Sommaire from '../../components/Sommaire.astro';
import { libelleCategorie, urlCategorie } from '../../data/categories-blog';
import { grasEnHtml, dateEnFrancais } from '../../utils/texte';
import { articlesPublies, articlesLies, urlArticle, urlListeBlog, type Article } from '../../utils/blog';
import { filArianeJsonLd, jsonLdTexte } from '../../utils/seo';

export async function getStaticPaths() {
  const publies = await articlesPublies(); // brouillons exclus
  return publies.map((article) => ({
    params: { slug: article.id },
    props: { article, lies: articlesLies(article, publies) },
  }));
}

interface Props {
  article: Article;
  lies: Article[];
}

const { article, lies } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);

// Sommaire : on ne garde que les titres de niveau 2 : ce sont les grandes
// parties de l'article. Les h3 rendraient le sommaire trop long (certains
// articles en comptent plus de quinze) et illisible sur mobile.
// Astro donne à chaque titre un id (titre.slug), cible des liens.
const sommaire = headings.filter((titre) => titre.depth === 2);
// Moins de 3 parties : pas de sommaire, pas de colonne de gauche.
const avecSommaire = sommaire.length >= 3;
const entreesSommaire = sommaire.map((titre) => ({ id: titre.slug, texte: titre.text }));

const SITE = Astro.site ?? new URL('https://akelia.fr');
const absolue = (chemin: string) => new URL(chemin, SITE).href;
const categorie = libelleCategorie(data.categorie);
// Fil d'Ariane : Accueil › Blog › catégorie (lien vers sa page). Le
// JSON-LD y ajoute l'article lui-même, page courante.
const filAriane = [
  { libelle: 'Accueil', href: '/' },
  { libelle: 'Blog', href: urlListeBlog(undefined) },
  { libelle: categorie, href: urlCategorie(data.categorie) },
];
const iso = (date: Date) => date.toISOString().slice(0, 10);

// --- SEO -----------------------------------------------------------------
const titrePage = data.titreSeo ?? data.titre;
// Canonique : /post/<slug>, sans barre finale, comme sur Webflow.
const canonique = absolue(urlArticle(article));
// Image de partage : la couverture, optimisée par Astro (1200px de large,
// JPEG : le format le plus sûr pour les réseaux sociaux).
const imagePartage = await getImage({ src: data.image, width: 1200, format: 'jpg' });
const urlImagePartage = absolue(imagePartage.src);

const organisation = { '@type': 'Organization', name: 'Akelia', url: SITE.href };
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.titre,
    description: data.description,
    image: [urlImagePartage],
    datePublished: iso(data.datePublication),
    dateModified: iso(data.dateMaj ?? data.datePublication),
    author: organisation,
    publisher: organisation,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonique },
  },
];
jsonLd.push(filArianeJsonLd([
  ...filAriane.map((etape) => ({ nom: etape.libelle, url: etape.href })),
  { nom: data.titre, url: urlArticle(article) },
], SITE));
if (data.videoYoutube) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: data.titre,
    description: data.description,
    thumbnailUrl: [`https://i.ytimg.com/vi/${data.videoYoutube}/hqdefault.jpg`, urlImagePartage],
    uploadDate: iso(data.datePublication),
    embedUrl: `https://www.youtube-nocookie.com/embed/${data.videoYoutube}`,
  });
}

// --- Vidéo ---------------------------------------------------------------
// Proportion de la vidéo (« 16 / 9 », « 1 / 1 », « 5 / 4 ») : une vidéo
// plus haute que du 16:9 est dite verticale ; elle est plafonnée à 420px
// de large et centrée, pour ne pas occuper tout l'écran en hauteur.
const [largeurVideo, hauteurVideo] = data.videoProportion.split('/').map((n) => Number(n.trim()));
const videoVerticale = largeurVideo / hauteurVideo < 16 / 9 - 0.01;

// --- Chapeau : un paragraphe par bloc séparé d'une ligne vide ------------
const chapeau = data.chapeau.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// --- Sources : liens externes en nofollow, nouvel onglet -----------------
const sources = data.sources.map((source) => ({ ...source, interne: source.lien.startsWith('/') }));

// Classes communes
// Petit appel à l'action de la colonne de gauche.
const classesBoutonDevis =
  'flex min-h-12 w-full items-center justify-center rounded-bloc bg-action-500 px-4 text-base font-semibold text-texte shadow-legere hover:bg-action-600 hover:inset-shadow-presse focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900';
const classesLienCollectif =
  'mt-3 flex min-h-11 items-center justify-center text-center text-base text-texte-doux underline underline-offset-4 hover:text-nuit-900 focus-visible:outline-2 focus-visible:outline-nuit-900';
const classesLienTexte = 'font-semibold text-nuit-900 underline underline-offset-4 hover:text-vert-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nuit-900';
---

<Layout title={titrePage} description={data.description} image={urlImagePartage} canonicalURL={canonique} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={iso(data.datePublication)} />
    {data.dateMaj && <meta property="article:modified_time" content={iso(data.dateMaj)} />}
    <meta property="article:section" content={categorie} />
    {jsonLd.map((objet) => <script type="application/ld+json" set:html={jsonLdTexte(objet)} />)}
  </Fragment>

  <article class="bg-fond">
    {/* ===== ZONE 1 : EN-TÊTE (56rem, centrée, texte aligné à gauche) ===== */}
    <div class="mx-auto max-w-[calc(56rem+2*var(--spacing-gouttiere))] px-gouttiere pt-8 md:pt-12">

      {/* FIL D'ARIANE */}
      <FilAriane etapes={filAriane} />

      {/* CATÉGORIE, TITRE, DATES */}
      <header class="mt-6">
        <p class="surtitre">{categorie}</p>
        <h1 class="mt-3 max-w-[30ch] text-h1 text-balance text-texte">{data.titre}</h1>
        <p class="mt-4 flex flex-wrap gap-x-3 text-base text-texte-doux">
          <span>Publié le <time datetime={iso(data.datePublication)}>{dateEnFrancais(data.datePublication)}</time></span>
          {data.dateMaj && (
            <>
              <span aria-hidden="true">·</span>
              <span>Mis à jour le <time datetime={iso(data.dateMaj)}>{dateEnFrancais(data.dateMaj)}</time></span>
            </>
          )}
        </p>
      </header>

      {/* CHAPEAU : plus grand que le corps, ni gras ni centré. */}
      <div class="mt-6 max-w-[60ch] space-y-4 text-chapeau text-texte">
        {chapeau.map((paragraphe) => <p>{paragraphe}</p>)}
      </div>

      {/* VIDÉO (si présente) OU COUVERTURE, jamais les deux.
          Vidéo : youtube-nocookie.com (pas de cookie YouTube tant que la
          vidéo n'est pas lancée), chargée à l'approche (loading="lazy"),
          proportion d'origine (videoProportion). */}
      {data.videoYoutube ? (
        <div class:list={['mt-8 overflow-hidden rounded-bloc bg-nuit-900 shadow-legere', videoVerticale && 'mx-auto max-w-[420px]']} style={`aspect-ratio: ${data.videoProportion}`}>
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${data.videoYoutube}`}
            title={`Vidéo : ${data.titre}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="size-full border-0"
          ></iframe>
        </div>
      ) : (
        <Image
          src={data.image}
          alt={data.imageAlt}
          widths={[400, 700, 900, 1300, 1800]}
          sizes="(min-width: 936px) 896px, calc(100vw - 2.5rem)"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="mt-8 h-auto w-full rounded-bloc"
        />
      )}
    </div>

    {/* ===== ZONE 2 : CORPS (72rem) =====
        Avec sommaire, à partir de 992px : colonne collante de 16rem à
        gauche, 3rem d'écart, texte à droite. Sans sommaire : une colonne
        centrée. */}
    <div class:list={[
      'mx-auto px-gouttiere pt-10 pb-scene md:pt-12',
      avecSommaire
        ? 'max-w-[calc(72rem+2*var(--spacing-gouttiere))] lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12'
        : 'max-w-[calc(70ch+2*var(--spacing-gouttiere))] lg:text-[1.25rem]',
    ]}>

      {/* COLONNE DE GAUCHE (ordinateur) : sommaire collant et petit appel
          à l'action (Sommaire.astro). Le bloc ne dépasse jamais la hauteur
          de l'écran : au-delà, seule la liste des parties défile, l'appel à
          l'action reste visible. */}
      {avecSommaire && (
        <Sommaire forme="colonne" entrees={entreesSommaire} libelle="Sommaire de l'article">
          <a href="/devis" class={classesBoutonDevis}>Demander un devis</a>
          <a href="/qui-sommes-nous" class={classesLienCollectif}>Akelia, le collectif d'artisans locaux</a>
        </Sommaire>
      )}

      {/* COLONNE DE DROITE : 70ch au plus (environ 700px à 20px). La
          taille de 20px posée ici (lg) sert de base au calcul de « ch ». */}
      <div class:list={['min-w-0', avecSommaire && 'max-w-[70ch] lg:text-[1.25rem]']}>

        {/* « EN BREF » : fond vert pâle, filet vert à gauche. Le bloc le
            plus lu : il doit se repérer d'un coup d'œil. Texte 14,41:1. */}
        {data.enBref.length > 0 && (
          <aside aria-labelledby="en-bref-titre" class="rounded-bloc border-l-[6px] border-vert-600 bg-vert-50 p-6 sm:p-8">
            <h2 id="en-bref-titre" class="text-h4 font-black text-texte">En bref</h2>
            <ul class="mt-4 list-disc space-y-3 pl-6 text-corps text-texte marker:text-vert-600">
              {data.enBref.map((ligne) => <li set:html={grasEnHtml(ligne)} />)}
            </ul>
          </aside>
        )}

        {/* SOMMAIRE SUR TÉLÉPHONE ET TABLETTE : replié (Sommaire.astro). */}
        {avecSommaire && <Sommaire forme="replie" entrees={entreesSommaire} libelle="Sommaire de l'article" class="mt-8" />}

        {/* CORPS DE L'ARTICLE : 18px, puis 20px à partir de 992px. */}
        <div data-article-corps class:list={['prose prose-lg max-w-none lg:prose-xl', (data.enBref.length > 0 || avecSommaire) && 'mt-10']}>
          <Content />
        </div>

        {/* SOURCES */}
        {sources.length > 0 && (
          <section aria-labelledby="sources-titre" class="mt-12 border-t border-creme-fonce pt-8">
            <h2 id="sources-titre" class="text-h4 font-black text-texte">Sources</h2>
            <ul class="mt-4 space-y-2 text-corps">
              {sources.map((source) => (
                <li>
                  {source.interne ? (
                    <a href={source.lien} class={classesLienTexte}>{source.libelle}</a>
                  ) : (
                    <a href={source.lien} rel="nofollow noopener" target="_blank" class={classesLienTexte}>
                      {source.libelle}<span class="sr-only"> (nouvel onglet)</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* GRAND APPEL À L'ACTION : bloc bleu nuit, surtitre orange,
            bouton orange (style de la section Collectif de l'accueil).
            Contour de focus blanc sur le fond sombre.
            Le lien « Akelia, le collectif d'artisans locaux » y est ajouté
            quand il n'est pas déjà dans la colonne de gauche (téléphone,
            tablette, ou article sans sommaire) : un seul bouton « devis »
            en fin d'article, pas deux à la suite. */}
        <section aria-labelledby="cta-titre" class="mt-14 rounded-bloc bg-nuit-900 px-6 py-10 text-center text-texte-inverse sm:px-10">
          <p class="surtitre text-action-500">Votre projet</p>
          <h2 id="cta-titre" class="mx-auto mt-3 max-w-[22ch] text-h3 text-balance">Un artisan du collectif étudie votre projet</h2>
          <p class="mx-auto mt-4 max-w-[45ch] text-corps">Il vous rappelle sous 24 à 48 heures, se déplace gratuitement et vous remet un devis détaillé.</p>
          <a
            href="/devis"
            class="mt-8 inline-flex min-h-12 items-center justify-center rounded-bloc bg-action-500 px-6 py-3 text-corps font-semibold text-texte shadow-legere hover:bg-action-600 hover:inset-shadow-presse focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-texte-inverse"
          >
            Demander un devis gratuit
          </a>
          <p class:list={['mt-4', avecSommaire && 'lg:hidden']}>
            <a href="/qui-sommes-nous" class="inline-flex min-h-11 items-center text-base text-texte-inverse underline underline-offset-4 hover:text-action-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-texte-inverse">Akelia, le collectif d'artisans locaux</a>
          </p>
        </section>
      </div>
    </div>
  </article>

  {/* ===== ZONE 3 : ARTICLES LIÉS (cartes de la page d'accueil) ===== */}
  {lies.length > 0 && (
    <section aria-labelledby="lies-titre" class="bg-creme">
      <div class="mx-auto max-w-site px-gouttiere py-scene">
        <h2 id="lies-titre" class="text-h3 text-texte">À lire aussi</h2>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {lies.map((lie) => <CarteArticle article={lie} />)}
        </div>
      </div>
    </section>
  )}

  {/* SUIVI DE LA LECTURE : script de Sommaire.astro. */}
</Layout>
